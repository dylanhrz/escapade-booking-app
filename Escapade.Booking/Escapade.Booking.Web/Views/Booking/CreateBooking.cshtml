@model BookingCreateBookingViewModel

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
}

@{
    ViewData["Title"] = "Boeking Aanvraag";
}

<section class="full-bleed position-relative">
    <div class="container-fluid p-0">
        <form asp-controller="Booking" asp-action="CreateBooking" method="post" enctype="multipart/form-data">
            
            <div asp-validation-summary="ModelOnly" class="text-danger p-3 fw-bold border-bottom border-dark"></div>

            <div class="form-grid">

            <div class="form-cell col-12 col-md-6 p-5">
                    
                    <label asp-for="Name" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Name" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Naam</span>
                        }
                    </label>

                    <input asp-for="Name" class="form-input"/>
                </div>

                <div class="form-cell col-12 col-md-6 p-5">
                    
                    <label asp-for="Email" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Email" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Email</span>
                        }
                    </label>
                    
                    <input asp-for="Email" class="form-input" />
                </div>

                <div class="form-cell col-12 col-md-6 p-5">
                    
                    <label asp-for="PhoneNumber" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Telefoonnummer</span>
                        }
                    </label>
                    
                    <input asp-for="PhoneNumber" class="form-input" />
                </div>

                <div class="form-cell col-12 col-md-6 p-5">
                    
                    <label asp-for="NumberOfGuests" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["NumberOfGuests"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["NumberOfGuests"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else
                        {
                            <span class="form-label">Aantal gasten</span>
                        }
                    </label>
                    
                    <input asp-for="NumberOfGuests" class="form-input" />
                </div>

                <div class="form-cell col-12 col-md-6 p-5 d-flex flex-column justify-content-center">
                    
                    <label class="fw-bolder text-uppercase small mb-5">
                        @if (ViewData.ModelState["StartDate"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["StartDate"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else if (ViewData.ModelState["EndDate"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["EndDate"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else
                        {
                            <span class="form-label">Selecteer Periode</span>
                        }
                    </label>
                    
                    <input type="hidden" asp-for="StartDate" id="StartDate" />
                    <input type="hidden" asp-for="EndDate" id="EndDate" />
                    
                    <div class="w-100">
                        <div id="inline-calendar"></div>
                    </div>
                    
                </div>

                <div class="form-cell col-12 col-md-6 p-5">
                    <label asp-for="Comment" class="fw-bolder text-uppercase small">
                        <span class="form-label">Opmerking of Vraag</span>
                    </label>
                    <span asp-validation-for="Comment" class="text-danger small d-block"></span>
                    <textarea asp-for="Comment" id="Comment" class="form-input" rows="5"></textarea>
                </div>

                <div class="form-cell form-inverted col-12 p-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <h3 class="display-6 fw-bold text-white m-0">Klaar om te verzenden?</h3>
                    <button type="submit" class="form-btn w-auto px-5">
                        Aanvraag Versturen
                    </button>
                </div>

            </div>
        </form>
    </div>
</section>