@model BookingCreateBookingViewModel

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
}

@{
    ViewData["Title"] = "Verblijf aanvragen | Boekingsaanvraag";
    ViewData["MetaDescription"] = "Vraag je verblijf in L'Escapade Ardennaise aan: kies je periode, geef het aantal gasten door en stuur je aanvraag direct naar de eigenaars.";
}

<section class="page-header container">
    <span class="contact-label mb-3">L'Escapade Ardennaise</span>
    <h1>Verblijf aanvragen</h1>
    <p>
        Kies je periode, vul je gegevens in en stuur je aanvraag. De eigenaars nemen daarna persoonlijk contact met je op.
    </p>
</section>

<div class="full-bleed border-top-1"></div>

<section class="position-relative">
    <div class="container-fluid p-0">

        <form id="booking" asp-controller="Booking" asp-action="CreateBooking" method="post" enctype="multipart/form-data" novalidate>

            <div asp-validation-summary="ModelOnly" class="text-danger p-4 fw-bold border-bottom border-dark border-1" role="alert"></div>

            <div class="row g-0">
                <div class="form-cell col-12 col-md-6 border-end-1 border-start-1">
                    <label asp-for="Name" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Name"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Name" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Naam</span>
                        }
                    </label>

                    <input asp-for="Name" class="form-input" autocomplete="name"/>
                </div>

                <div class="form-cell col-12 col-md-6 border-end-1">
                    <label asp-for="Email" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Email" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">E-mail</span>
                        }
                    </label>

                    <input asp-for="Email" class="form-input" type="email" autocomplete="email" inputmode="email"/>

                    <div class="custom-validation-summary d-none" id="emailValidationError" role="alert">
                        <p class="mt-2">
                            Vul een geldig e-mailadres in voordat je de aanvraag verstuurt.
                        </p>
                    </div>
                </div>

                <div class="form-cell col-12 col-md-6 border-end-1 border-start-1">
                    <label asp-for="PhoneNumber" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Telefoonnummer</span>
                        }
                    </label>

                    <input asp-for="PhoneNumber" class="form-input" type="tel" autocomplete="tel" inputmode="tel"/>
                </div>

                <div class="form-cell col-12 col-md-6 border-end-1">
                    <label asp-for="NumberOfGuests" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["NumberOfGuests"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["NumberOfGuests"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else
                        {
                            <span class="form-label">Aantal gasten</span>
                        }
                    </label>

                    <input asp-for="NumberOfGuests" class="form-input" inputmode="numeric" min="1" max="10"/>
                </div>

                <div class="form-cell col-12 d-flex flex-column justify-content-center border-start-1 border-end-1">
                    <label class="fw-bolder text-uppercase small mb-5" for="inline-calendar">
                        @if (ViewData.ModelState["StartDate"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["StartDate"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else if (ViewData.ModelState["EndDate"]?.Errors.Count > 0)
                        {
                            <span class="text-danger">
                                @ViewData.ModelState["EndDate"]!.Errors[0].ErrorMessage
                            </span>
                        }
                        else
                        {
                            <span class="form-label">Selecteer periode</span>
                        }
                    </label>

                    <input type="hidden" asp-for="StartDate"/>
                    <input type="hidden" asp-for="EndDate"/>

                    <div class="w-100">
                        <div id="inline-calendar"></div>
                    </div>
                </div>

                <div class="form-cell col-12 border-start-1 border-end-1">
                    <label asp-for="Comment" class="fw-bolder text-uppercase small">
                        <span class="form-label">Opmerking of vraag</span>
                    </label>
                    <span asp-validation-for="Comment" class="text-danger small d-block"></span>
                    <textarea asp-for="Comment" class="form-input" rows="5"></textarea>
                </div>

                <div class="form-inverted col-12">
                    <button type="button" class="form-submit-button" onclick="openConfirmationModal()">
                        <span>Aanvraag versturen</span>
                    </button>
                </div>

            </div>
        </form>
    </div>
</section>

<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-1">
            <div class="modal-header form-inverted border-bottom-1">
                <h2 class="modal-title fs-5 text-uppercase font-serif" id="confirmationModalLabel">Bevestig je aanvraag</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">
                    Controleer je e-mailadres voordat je de aanvraag definitief verstuurt:
                </p>
                <div class="p-3 border-1 fw-bold text-break mb-3 fs-5" id="confirmEmailDisplay"></div>
                <p class="text-muted small m-0">
                    Klopt dit e-mailadres? Dan sturen wij je boekingsaanvraag direct door naar de eigenaars.
                </p>
            </div>
            <div class="modal-footer border-top-1 d-flex justify-content-between">
                <button type="button" class="custom-button-outline px-4 py-2 text-uppercase fw-bold" data-bs-dismiss="modal">
                    Aanpassen
                </button>
                <button type="button" class="custom-button px-4 py-2 text-uppercase fw-bold" onclick="submitForm()">
                    Verstuur naar eigenaar
                </button>
            </div>
        </div>
    </div>
</div>