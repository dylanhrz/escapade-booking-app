@{
    ViewData["Title"] = "Boeking Ontvangen";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <span class="text-uppercase px-3 py-1 mb-3">Confirmation</span>
        
        <h1 class="display-3 fw-bold text-uppercase mb-3">Bedankt voor je aanvraag!</h1>
        
        <p class="lead text-secondary mb-4">
            We hebben je boekingsaanvraag goed ontvangen. Wendy neemt zo snel mogelijk contact met je op om je verblijf te bevestigen.
        </p>
        
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-0 text-uppercase px-4 py-3 fw-bold">
                Terug naar Home
            </a>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-dark rounded-0 text-uppercase px-4 py-3 fw-bold">
                Contactgegevens
            </a>
        </div>
    </div>
</div>