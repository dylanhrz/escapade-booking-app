@{
    ViewData["Title"] = "Boeking Ontvangen";
}

<section class="full-bleed position-relative min-vh-50 d-flex align-items-center justify-content-center">   
    <div class="container-fluid p-0">
        <div class="text-center d-flex flex-column align-items-center justify-content-center">
            
            <span class="text-uppercase px-3 py-1 mb-1">We hebben je boekingsaanvraag goed ontvangen</span>
            <h1 class="display-3 fw-bold mb-4">Bedankt voor je aanvraag!</h1>

            <p class="lead mb-4">
                Wendy neemt zo snel mogelijk contact met je op om je verblijf te bevestigen.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn custom-button rounded-0 text-uppercase px-4 py-3 fw-bold">
                    Terug
                </a>
                <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-dark rounded-0 text-uppercase px-4 py-3 fw-bold">
                    Contactgegevens
                </a>
            </div>
            
        </div>
    </div>
</section>