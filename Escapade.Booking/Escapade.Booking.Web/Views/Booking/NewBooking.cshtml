@model BookingNewBookingViewModel

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
}

<form asp-controller="Booking" 
      asp-action="NewBooking" 
      method="post" 
      enctype="multipart/form-data"
      class="w-100 mx-auto p-4 p-md-5 my-5">
    
    <div asp-validation-summary="ModelOnly" class="text-danger text-uppercase small mb-3"></div>
    
    <div class="row g-3 mb-4">
        
        <div class="col-md-12">
            <label asp-for="Name" class="form-label fw-bold mb-1 small text-uppercase">Naam:</label>
            <span asp-validation-for="Name" class="text-danger small d-block mb-1"></span>
            <input asp-for="Name" 
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2" 
                   placeholder="Voornaam Achternaam" />
        </div>

        <div class="col-md-12">
            <label asp-for="Email" class="form-label fw-bold mb-1 small text-uppercase">E-mailadres:</label>
            <span asp-validation-for="Email" class="text-danger small d-block mb-1"></span>
            <input asp-for="Email" 
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2" 
                   placeholder="naam@voorbeeld.be" />
        </div>

        <div class="col-md-12">
            <label asp-for="PhoneNumber" class="form-label fw-bold mb-1 small text-uppercase">Telefoonnummer:</label>
            <span asp-validation-for="PhoneNumber" class="text-danger small d-block mb-1"></span>
            <input asp-for="PhoneNumber" 
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2" 
                   placeholder="+32 4XX XX XX XX" />
        </div>
        
    </div>
    
    <div class="row g-3 mb-4">
        
        <!--
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label fw-bold mb-1 small text-uppercase">Aankomstdatum:</label>
            <span asp-validation-for="StartDate" class="text-danger small d-block mb-1"></span>
            <input asp-for="StartDate"
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2"/>
        </div>

        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label fw-bold mb-1 small text-uppercase">Vertrekdatum:</label>
            <span asp-validation-for="EndDate" class="text-danger small d-block mb-1"></span>
            <input asp-for="EndDate"
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2"/>
        </div>
        -->

        <input type="hidden" asp-for="StartDate" id="StartDate"/>
        <input type="hidden" asp-for="EndDate" id="EndDate"/>

        <div class="col-12 mb-3">
            <label class="form-label fw-bold mb-2 small text-uppercase">Selecteer datum bereik:</label>
            <span asp-validation-for="StartDate" class="text-danger small d-block mb-1"></span>
            <span asp-validation-for="EndDate" class="text-danger small d-block mb-1"></span>

            <div id="inline-calendar"></div>
        </div>

        <div class="col-md-12">
            <label asp-for="NumberOfGuests" class="form-label fw-bold mb-1 small text-uppercase">Aantal gasten:</label>
            <span asp-validation-for="NumberOfGuests" class="text-danger small d-block mb-1"></span>
            <input asp-for="NumberOfGuests"
                   class="form-control rounded-0 border-secondary-subtle px-3 py-2"
                   placeholder="Aantal personen (max. 10)"
                   min="1"
                   max="10"/>
        </div>
    </div>
    
    <div class="mb-4">
        <label asp-for="Comment" class="form-label fw-bold mb-1 small text-uppercase">Opmerking of vraag:</label>
        <span asp-validation-for="Comment" class="text-danger small d-block mb-1"></span>
        <textarea asp-for="Comment" 
              class="form-control rounded-0 border-secondary-subtle p-3" 
              rows="4" 
              placeholder="Laat hier eventuele extra wensen of vragen achter..."></textarea>
    </div>
    
    <div class="py-3">
        <button type="submit"
                class="btn border-0 text-decoration-underline btn-custom-hover fw-bold font-serif text-dark">
            <i class="bi bi-check-lg"></i>
            Aanvraag versturen
        </button>
    </div>
    
</form>