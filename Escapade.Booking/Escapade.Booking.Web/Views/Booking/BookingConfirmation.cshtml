@{
    ViewData["Title"] = "Boeking Ontvangen";
}

<section class="full-bleed position-relative min-vh-50">   
    <div class="container-fluid p-0">
        <div>
            
            <h2 class="font-non-serif p-5 border border-bottom-2">Danku, u boekingaanvraag is verstuurd</h2>

            <p class="lead mb-4">
                Wendy neemt zo snel mogelijk contact met je op om je verblijf te bevestigen.
            </p>
            
            <p>
                Je kan 
                <a asp-controller="Booking" asp-action="TrackBooking" asp-route-token="@ViewBag.Token">
                    je volledige boekingaanvraag bekijken hier
                </a>, 
                of in je inbox van je email.
            </p>            
        </div>
    </div>
</section>