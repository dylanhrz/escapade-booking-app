@model BookingTrackBooking

@{
    ViewData["Title"] = "Status Boeking";

    int currentStatus = Model.Status switch
    {
        "Pending" => 2,      // In behandeling
        "Approved" => 3,     // Goedgekeurd / Contact opgenomen
        "Paid" => 4,         // Betaling ontvangen
        "Completed" => 5,    // Alles in orde
        "Rejected" => 2,     // Geweigerd bij stap 2
        _ => 1               // Aanvraag ontvangen
    };

    bool isRejected = Model.Status == "Rejected";
}

<section class="full-bleed position-relative border-start-2 border-end-2">
    <div class="container-fluid p-0">
        
        <div class="row g-0 border-bottom-2">
            <div class="col-lg-4 p-4 p-lg-5 d-flex flex-column justify-content-between border-bottom border-bottom-lg-0">
                <span class="text-uppercase small fw-bold text-muted mb-2 mb-lg-0">@ViewData["Title"]</span>
                <h1 class="display-4 font-non-serif text-uppercase fw-light m-0">@Model.Name</h1>
            </div>
            <div class="col-lg-8 p-4 p-lg-5 d-flex align-items-center justify-content-start justify-content-lg-end">
                @if (Model.Status == "Pending")
                {
                    <span class="display-4 display-lg-2 font-non-serif text-uppercase color-green fw-light m-0">
                        In behandeling
                    </span>
                }
                else
                {
                    <span class="display-4 display-lg-2 font-non-serif text-uppercase fw-bold m-0">
                        @Model.Status
                    </span>
                }
            </div>
        </div>
        
        <div class="row g-0">
            
            <div class="col-12 col-md border-end-md-2 p-4 p-lg-5 text-center step-cell @("active") border-end-2">
                <span class="font-non-serif d-block mb-2 mb-lg-3">01</span>
                <p class="fw-bold text-uppercase m-0 small">Aanvraag Ontvangen</p>
            </div>

            <div class="col-12 col-md border-end-md-2 p-4 p-lg-5 text-center step-cell @(currentStatus >= 2 ? (isRejected ? "rejected" : "active") : "") border-end-2">
                <span class="font-non-serif d-block mb-2 mb-lg-3">02</span>
                <p class="fw-bold text-uppercase m-0 small">
                    @(isRejected ? "Geweigerd" : "In Behandeling")
                </p>
            </div>

            <div class="col-12 col-md border-end-md-2 p-4 p-lg-5 text-center step-cell @(currentStatus >= 3 ? "active" : "") border-end-2">
                <span class="font-non-serif d-block mb-2 mb-lg-3">03</span>
                <p class="fw-bold text-uppercase m-0 small">Goedgekeurd</p>
            </div>

            <div class="col-12 col-md border-end-md-2 p-4 p-lg-5 text-center step-cell @(currentStatus >= 4 ? "active" : "") border-end-2">
                <span class="font-non-serif d-block mb-2 mb-lg-3">04</span>
                <p class="fw-bold text-uppercase m-0 small">Betaling Ontvangen</p>
            </div>

            <div class="col-12 col-md p-4 p-lg-5 text-center step-cell @(currentStatus >= 5 ? "active" : "")">
                <span class="font-non-serif d-block mb-2 mb-lg-3">05</span>
                <p class="fw-bold text-uppercase m-0 small">Alles in orde, tot snel!</p>
            </div>

        </div>

        <div class="booking-tracking row g-0 border-bottom-2 border-top-2">
            <div class="col-lg-3 p-4 p-lg-5 border-end-lg-2 border-bottom border-bottom-lg-0 border-end-2">
                <h3 class="font-non-serif text-muted m-0 text-start text-lg-end">Boeking nummer</h3>
            </div>
            <div class="col-lg-9 p-4 p-lg-5 fw-bold text-break">
                <p class="m-0 font-monospace">@Model.AccessToken</p>
            </div>
        </div>

        <div class="booking-tracking row g-0 border-bottom-2">
            <div class="col-lg-3 p-4 p-lg-5 border-end-lg-2 border-bottom border-bottom-lg-0 border-end-2">
                <h3 class="font-non-serif text-muted m-0 text-start text-lg-end">Boeking aangevraagd</h3>
            </div>
            <div class="col-lg-9 p-4 p-lg-5 d-flex flex-column flex-sm-row align-items-start align-items-sm-baseline gap-1 gap-sm-3">
                <span class="fw-bold">
                    @Model.BookingRequested.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("nl-BE"))
                </span>
                <span class="text-muted small">
                    om @Model.BookingRequested.ToString("HH:mm") uur
                </span>
            </div>
        </div>
        
        <div class="booking-tracking row g-0 border-bottom-2">
            <div class="col-lg-3 p-4 p-lg-5 border-end-lg-2 border-bottom border-bottom-lg-0 border-end-2">
                <h3 class="font-non-serif text-muted m-0 text-start text-lg-end">Aantal gasten</h3>
            </div>
            <div class="col-lg-9 p-4 p-lg-5 fw-bold">
                <p class="m-0">@Model.NumberOfGuests</p>
            </div>
        </div>
        
        <div class="booking-tracking row g-0 border-bottom-2">
            <div class="col-lg-3 p-4 p-lg-5 border-end-lg-2 border-bottom border-bottom-lg-0 border-end-2">
                <h3 class="font-non-serif text-muted m-0 text-start text-lg-end">Aankomst Datum</h3>
            </div>
            <div class="col-lg-9 p-4 p-lg-5 fw-bold">
                <p class="m-0">@Model.StartDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        
        <div class="booking-tracking row g-0">
            <div class="col-lg-3 p-4 p-lg-5 border-end-lg-2 border-bottom border-bottom-lg-0 border-end-2">
                <h3 class="font-non-serif text-muted m-0 text-start text-lg-end">Datum van vertrek</h3>
            </div>
            <div class="col-lg-9 p-4 p-lg-5 fw-bold">
                <p class="m-0">@Model.EndDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

    </div>   
    
</section>