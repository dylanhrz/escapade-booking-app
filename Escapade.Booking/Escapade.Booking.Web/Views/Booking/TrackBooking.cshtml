@model BookingTrackBooking

@{
    ViewData["Title"] = "Je aanvraag";

    var culture = new System.Globalization.CultureInfo("nl-BE");
    var isApproved = Model.Status == "Approved";
    var nights = (Model.EndDate.Date - Model.StartDate.Date).Days;
    var reference = Model.AccessToken.ToString("N")[..8].ToUpper();
}

<section class="page-header container">
    <span class="contact-label mb-3">Je aanvraag · @Model.Name</span>
    <h1>@(isApproved ? "Goedgekeurd" : "Aanvraag ontvangen")</h1>
    <p>
        @if (isApproved)
        {
            @:Je verblijf is goedgekeurd. Tot binnenkort in Rocquigny!
        }
        else
        {
            @:Bedankt! We hebben je aanvraag goed ontvangen. Wendy neemt binnenkort persoonlijk contact met je op om alles te bespreken.
        }
    </p>
</section>

<section class="full-bleed border-top-1 border-bottom-1">
    <div class="container">
        <div class="track-grid border-start-1 border-end-1">

            <ol class="track-steps" aria-label="Status van je aanvraag">
                <li class="track-step is-done" @(isApproved ? "" : "aria-current=step")>
                    <span class="track-step-number">01</span>
                    <strong>Aanvraag ontvangen</strong>
                    <span>Wendy neemt persoonlijk contact met je op</span>
                </li>
                <li class="track-step @(isApproved ? "is-done" : "")" @(isApproved ? "aria-current=step" : "")>
                    <span class="track-step-number">02</span>
                    <strong>Goedgekeurd</strong>
                    <span>@(isApproved ? "Tot binnenkort in Rocquigny!" : "Na jullie gesprek")</span>
                </li>
            </ol>

            <div class="facts-bar track-details">
                <div class="facts-cell">
                    <span class="contact-label">Aankomst</span>
                    <strong>@Model.StartDate.ToString("d MMM yyyy", culture)</strong>
                    <span class="admin-booking-meta">@Model.StartDate.ToString("dddd", culture)</span>
                </div>
                <div class="facts-cell">
                    <span class="contact-label">Vertrek</span>
                    <strong>@Model.EndDate.ToString("d MMM yyyy", culture)</strong>
                    <span class="admin-booking-meta">@Model.EndDate.ToString("dddd", culture) · @nights @(nights == 1 ? "nacht" : "nachten")</span>
                </div>
                <div class="facts-cell">
                    <span class="contact-label">Gasten</span>
                    <strong>@Model.NumberOfGuests</strong>
                </div>
                <div class="facts-cell">
                    <span class="contact-label">Referentie</span>
                    <strong>@reference</strong>
                    <span class="admin-booking-meta">Aangevraagd op @Model.BookingRequested.ToString("d MMMM yyyy", culture)</span>
                </div>
            </div>

            <div class="track-contact">
                <div>
                    <span class="contact-label mb-2">Vragen over je aanvraag?</span>
                    <p class="mb-0">Neem gerust contact op met Wendy.</p>
                </div>
                <div class="admin-actions">
                    <a href="tel:+33673081169" class="btn-grid">Bel Wendy</a>
                    <a href="mailto:wendymartens19@gmail.com?subject=@(Uri.EscapeDataString($"Mijn aanvraag {reference}"))" class="btn-grid btn-grid-outline">Mail Wendy</a>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="container text-center py-5 my-4">
    <p class="section-text mb-3">Alvast in de stemming komen?</p>
    <a asp-controller="About" asp-action="Index" class="custom-link">Ontdek het verblijf</a>
</section>
