@model BookingTrackBooking

@{
    ViewData["Title"] = "Status Boeking";
    Layout = null;

    int currentStatus = Model.Status switch
    {
        "Pending" => 2,      // In behandeling
        "Approved" => 3,     // Goedgekeurd / Contact opgenomen
        "Paid" => 4,         // Betaling ontvangen
        "Completed" => 5,    // Alles in orde
        "Rejected" => 2,     // Geweigerd bij stap 2
        _ => 1               // Aanvraag ontvangen
    };

    bool isRejected = Model.Status == "Rejected";
    
}

<!DOCTYPE html>
<html lang="nl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - L'Escapade Ardennaise</title>
        
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>

    <body>
        <section class="full-bleed position-relative">
            <div class="container-fluid p-0">
                
                <div class="admin-cell p-4">
                    <h2 class="text-uppercase font-non-serif m-0 fw-lighter">@ViewData["Title"]</h2>
                </div>

                <div class="row g-0">
                    <div class="col-3 border-right border-dark border-2 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Boeking nummer</p>
                        <strong>@Model.AccessToken</strong>
                    </div>
                    <div class="col-3 border-right border-dark border-2 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Boeking aangevraagd</p>
                        <strong>@Model.BookingRequested</strong>
                    </div>
                    <div class="col-3 border-right border-dark border-2 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Aantal gasten</p>
                        <strong>@Model.NumberOfGuests</strong>
                    </div>
                    <div class="col-3 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Status</p>
                        <strong>@Model.Status</strong>
                    </div>
                </div>
                 
                <div class="row g-0 border-bottom-2 border-top-2">
                    <div class="col-6 border-right border-dark border-2 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Aankomst Datum</p>
                        <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="col-6 p-5 m-0 text-center">
                        <p class="text-muted text-uppercase">Vertrek Datum</p>
                        <strong>@Model.EndDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>
                
                <div class="admin-cell p-4">
                    <h2 class="text-uppercase font-non-serif m-0 fw-lighter">Boeking Tracking</h2>
                </div>
                
                <div class="row g-0 row-cols-5 border-bottom-2">
                    
                    <div class="col border-end-2 p-5 text-center step-cell active">
                        <div class="step-badge mb-2">1</div>
                        <p class="fw-bold text-uppercase m-0 extra-small">Aanvraag Ontvangen</p>
                    </div>

                    <div class="col border-end-2 p-5 text-center step-cell @(currentStatus >= 2 ? (isRejected ? "rejected" : "active") : "")">
                        <div class="step-badge mb-2">2</div>
                        <p class="fw-bold text-uppercase m-0 extra-small">
                            @(isRejected ? "Geweigerd" : "In Behandeling")
                        </p>
                    </div>

                    <div class="col border-end-2 p-5 text-center step-cell @(currentStatus >= 3 ? "active" : "")">
                        <div class="step-badge mb-2">3</div>
                        <p class="fw-bold text-uppercase m-0 extra-small">Goedgekeurd</p>
                    </div>

                    <div class="col border-end-2 p-5 text-center step-cell @(currentStatus >= 4 ? "active" : "")">
                        <div class="step-badge mb-2">4</div>
                        <p class="fw-bold text-uppercase m-0 extra-small">Betaling Ontvangen</p>
                    </div>

                    <div class="col p-5 text-center step-cell @(currentStatus >= 5 ? "active" : "")">
                        <div class="step-badge mb-2">5</div>
                        <p class="fw-bold text-uppercase m-0 extra-small">Alles in orde, tot snel!</p>
                    </div>

                </div>
                
                <div class="row g-0 border-bottom-2">
                    <div class="col-12">
                        <button type="button" 
                                onclick="window.location.reload();" 
                                class="w-100 p-5 text-uppercase fw-bold border-0 bg-transparent nav-block-btn">
                            Refresh
                        </button>
                    </div>
                </div>
                
            </div>
        </section>

    </body>
</html>