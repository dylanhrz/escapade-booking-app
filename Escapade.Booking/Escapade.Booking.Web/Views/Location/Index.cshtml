@{
    ViewData["Title"] = "Locatie";
}

<div class="container py-4" style="max-width: 500px;">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-start">
        
        <div class="ratio ratio-16x9">
            <iframe
                src="https://maps.google.com/maps?q=20%20Place%20Jean%20Mermoz,%2008220%20Rocquigny,%20France&t=&z=13&ie=UTF8&iwloc=&output=embed"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="border-0">
            </iframe>
        </div>

        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-1">Escapade Rocquigny</h5>
            
            <p class="text-secondary small mb-3">
                20 Place Jean Mermoz, 08220 Rocquigny (Frankrijk)
            </p>

            <div class="pt-1">
                <a href="https://www.google.com/maps/dir/?api=1&destination=20+Place+Jean+Mermoz,+08220+Rocquigny,+France"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-light rounded-pill text-dark fw-bold px-4 py-2 small border-0">
                    Open in Google Maps
                </a>
            </div>
        </div>

    </div>
</div>