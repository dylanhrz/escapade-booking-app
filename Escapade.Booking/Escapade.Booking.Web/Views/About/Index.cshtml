@* ONTSPANNINGSKAMER *@
<section id="massage" class="room-split-section full-bleed">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-6 room-info-side d-flex flex-column justify-content-between p-5">
                <div>
                    <h2>Ontspanningskamer</h2>
                    <p class="mt-4 mb-4">
                        Kies voor pure ontspanning met onze infraroodsauna, andullatiematras of boek een heerlijke massage.
                    </p>
                    <div class="text-uppercase row g-3 my-5 py-5">
                        <div class="col-6">
                            <p class="fw-bold mb-0">Relax massage nek</p>
                            <p class="text-muted mb-0">15 min. / €20</p>
                        </div>
                        <div class="col-6">
                            <p class="fw-bold mb-0">Relax massage rug</p>
                            <p class="text-muted mb-0">20 min. / €25</p>
                            <p class="text-muted mb-0">+ manuele therapie + €10</p>
                        </div>
                        <div class="col-6">
                            <p class="fw-bold mb-0">Sportmassage benen</p>
                            <p class="text-muted mb-0">20 min. / €25</p>
                        </div>
                        <div class="col-6">
                            <p class="fw-bold mb-0">Voetreflexologie</p>
                            <p class="text-muted mb-0">20 min. / €30</p>
                        </div>
                    </div>
                </div>
                <div class="pt-5">
                    <a asp-controller="Booking" asp-action="CreateBooking" class="custom-link">Vraag een verblijf aan</a>
                </div>
            </div>
            <div class="col-lg-6 border-start-2">
                <div class="room-carousel">
                    <div class="carousel-track">
                        <img src="~/images/detente/IMG_4855.JPG" alt="Ontspanningskamer" class="carousel-img active" />
                        <img src="~/images/detente/IMG_4859.JPG" alt="Ontspanningskamer" class="carousel-img" loading="lazy" />
                        <img src="~/images/detente/IMG_4862.JPG" alt="Ontspanningskamer" class="carousel-img" loading="lazy" />
