<!-- SLAAPKAMERS -->
<section id="bedroom" class="room-section">
    <div class="title-section text-center mb-5">
        <h2>SLAAPKAMERS</h2>
        <p class="text-uppercase w-50 mx-auto p-1">
            Rust en comfort staan centraal tijdens je verblijf. Geniet na een dag in de natuur van onze ruime, 
            karaktervolle kamers en van een heerlijke nachtrust in een ontspannen omgeving. 
            L'Escapade Ardennaise biedt plaats aan groepen tot 10 personen, inclusief comfortabele bedden en 
            aanwezig bedlinnen. 's Morgens word je uitgerust wakker, klaar om te genieten van de rust en 
            het mooie uitzicht op de Ardense natuur.
        </p>
    </div>
    
    <div class="row g-1">
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/evasion/IMG_4819.JPG")')">
                <img src="~/images/evasion/IMG_4819.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/IMG_4875.JPG")')">
                <img src="~/images/IMG_4875.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/IMG_4896.JPG")')">
                <img src="~/images/IMG_4896.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-5">
        <a asp-controller="About"
           asp-action="Rooms"
           class="btn btn-outline-dark btn-custom text-uppercase px-4 py-2 border-1 rounded-0 w-100">
            Ontdek alle slaapkamers
        </a>  
    </div>
</section>

<!-- ONTSPANNINGSRUIMTE -->
<section id="massage" class="room-section">
    <div class="title-section mb-5 text-start">
        <h2 class="text-uppercase">Ontspanningskamer</h2>
        <p class="text-uppercase w-25 p-1">
            Genieten in de ontspanningskamer van de infra-rood sauna, andullatiematras en
            massage op aanvraag
        </p>    
    </div>
    
    <div class="row g-1">
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/detente/IMG_4855.JPG")')">
                <img src="~/images/detente/IMG_4855.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
        
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/detente/IMG_4859.JPG")')">
                <img src="~/images/detente/IMG_4859.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
        
        <div class="col-lg-4 col-sm-6">
            <div class="img-container" onclick="openLightbox('@Url.Content("~/images/detente/IMG_4862.JPG")')">
                <img src="~/images/detente/IMG_4862.JPG"
                     alt="L'Escapade Ardennaise"
                     class="grid-img-2"/>
            </div>
        </div>
    </div>
    
    <div class="row text-uppercase mt-5">
        <div class="col-md-12 col-sm-6 mb-3">
            <p class="fw-bold mb-0">Relax massage nek</p>
            <p class="text-muted mb-0">15 min. / €20</p>
        </div>
        <div class="col-md-12 col-sm-6 mb-3">
            <p class="fw-bold mb-0">Relax massage rug</p>
            <p class="text-muted mb-0">20 min. / €25</p>
            <p class="text-muted mb-0">+ manuele therapie + €10</p>
        </div>
        <div class="col-md-12 col-sm-6 mb-3">
            <p class="fw-bold mb-0">Sportmassage benen</p>
            <p class="text-muted mb-0">20 min. / €25</p>
        </div>
        <div class="col-md-12 col-sm-6 mb-3">
            <p class="fw-bold mb-0">Voetreflexologie</p>
            <p class="text-muted mb-0">20 min. / €30</p>
        </div>
    </div>
</section>

<section class="cta-section d-flex flex-column justify-content-center align-items-center">
    <div class="container">
        <div class="row mb-5 g-4 align-items-center">
            <div class="cta-section-content col-lg-12">
                <h3>
                    Verblijven in <br/>
                    L'Escapade Ardennaise?
                </h3>    
                <p class="w-75 mx-auto">
                    Verblijven in een sfeervol toevluchtsoord in Rocquigny, omgeven door glooiende landschappen en
                    dorpscharme.
                </p>   
                <a asp-controller="Booking"
                   asp-action="CreateBooking"
                   class="btn btn-outline-dark btn-custom-outline px-4 py-2 border-1 rounded-0 text-uppercase">
                    Vraag een verblijf aan
                </a>   
            </div>
        </div>
    </div>
</section>  

<div id="custom-cursor">BEKIJK</div>
        
