            Tuin
        </a>
        <a href="#farm" 
           class="btn btn-outline-dark btn-custom text-uppercase rounded-0">
            Boerderij
        </a>
        <a href="#barn" 
           class="btn btn-outline-dark btn-custom text-uppercase rounded-0">
            Schuur
        </a>
    </div>
</section>

