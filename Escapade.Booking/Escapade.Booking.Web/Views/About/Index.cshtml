@* SCHUUR *@
<section id="barn" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Schuur</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Karaktervolle overdekte schuurruimte geschikt voor diverse ontspanningsactiviteiten.
            </p>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/IMG_5008.jpeg" alt="Schuur, foto 1 van 4" class="carousel-img active" />
                    <img src="~/images/house/IMG_4618.JPG" alt="Schuur, foto 2 van 4" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4786.JPG" alt="Schuur, foto 3 van 4" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4785.JPG" alt="Schuur, foto 5 van 4" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section d-flex flex-column justify-content-center align-items-center">
    <div class="container">
        <div class="row mb-5 g-4 align-items-center">
            <div class="cta-section-content col-lg-12">
                <h2>Plan je verblijf</h2>
                <p class="w-75 mx-auto">
                    Kies je periode en stuur je aanvraag. De eigenaars nemen daarna persoonlijk contact met je op.
                </p>
                <a asp-controller="Booking" asp-action="CreateBooking" class="btn-grid">Vraag je verblijf aan</a>
            </div>
        </div>
    </div>
</section>
