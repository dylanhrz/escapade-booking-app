@{
    ViewData["Title"] = "Het verblijf";
    ViewData["MetaDescription"] = "Ontdek de woonkamer, keuken, slaapkamers, ontspanningskamer, tuin en schuur van L'Escapade Ardennaise, een vakantiewoning voor groepen tot 10 personen in Rocquigny.";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4787.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4928.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4925.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4794.JPG" alt="" />
        </div>

        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4787.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4928.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4925.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4794.JPG" alt="" loading="lazy" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>VERBLIJF</h1>
    </div>
</section>

<nav class="section-nav full-bleed border-top-1 border-bottom-1" aria-label="Ruimtes van het verblijf">
    <ul>
        <li><a href="#livingroom">Woonkamer</a></li>
        <li><a href="#bathroom">Badkamers</a></li>
        <li><a href="#kitchen">Keuken</a></li>
        <li><a href="#bedroom">Slaapkamers</a></li>
        <li><a href="#massage">Ontspanningskamer</a></li>
        <li><a href="#garden">Tuin</a></li>
        <li><a href="#farm">Boerderij</a></li>
        <li><a href="#barn">Schuur</a></li>
    </ul>
</nav>

<section class="container intro-section">
    <p class="text-center">
        Een sfeervolle vakantiewoning in Rocquigny voor groepen tot 10 personen, met alle comfort om samen
        te koken, te ontspannen en buiten te genieten. Ontdek hieronder elke ruimte van de woning.
    </p>
</section>

@* WOONKAMER *@
<section id="livingroom" class="room-split-section full-bleed border-top-1">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Woonkamer</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Een ruime, sfeervolle woonkamer ingericht om samen te komen. Geniet van gezellige avonden bij de kachel of een goed boek in de comfortabele zithoek.
            </p>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/house/IMG_4794.JPG" alt="Woonkamer, foto 1 van 3" class="carousel-img active" />
                    <img src="~/images/house/IMG_4918.JPG" alt="Woonkamer, foto 2 van 3" class="carousel-img" loading="lazy" />
                    <img src="~/images/IMG_5004.JPEG" alt="Woonkamer, foto 3 van 3" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* BADKAMERS *@
<section id="bathroom" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Badkamers</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Moderne en verzorgde sanitairvoorzieningen uitgerust met alle comfort voor een verfrissende start van de dag.
            </p>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/house/IMG_4931.JPG" alt="Badkamers, foto 1 van 3" class="carousel-img active" />
                    <img src="~/images/house/IMG_4836.JPG" alt="Badkamers, foto 2 van 3" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4810.JPG" alt="Badkamers, foto 3 van 3" class="carousel-img" loading="lazy" />
                    <img src="~/images/IMG_5005.jpeg" alt="Badkamers, foto 3 van 3" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* KEUKEN *@
<section id="kitchen" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Keuken</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Volledig uitgeruste keuken met alle benodigde apparatuur om heerlijke maaltijden te bereiden voor het hele gezelschap.
            </p>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/IMG_5006.jpeg" alt="Keuken, foto 1 van 5" class="carousel-img active" />
                    <img src="~/images/house/IMG_4928.JPG" alt="Keuken, foto 2 van 5" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4936.JPG" alt="Keuken, foto 3 van 5" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4937.JPG" alt="Keuken, foto 4 van 5" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4940.JPG" alt="Keuken, foto 5 van 5" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* SLAAPKAMERS *@
<section id="bedroom" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Slaapkamers</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Comfortabele en karaktervolle slaapkamers ontworpen voor een optimale nachtrust tijdens uw verblijf.
            </p>
                <div class="pt-4">
                    <a asp-controller="About" asp-action="Rooms" class="btn-grid">Ontdek alle slaapkamers</a>
                </div>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/IMG_5007.jpeg" alt="Slaapkamers, foto 1 van 4" class="carousel-img active" />
                    <img src="~/images/evasion/IMG_4819.JPG" alt="Slaapkamers, foto 2 van 4" class="carousel-img" loading="lazy" />
                    <img src="~/images/IMG_4875.JPG" alt="Slaapkamers, foto 3 van 4" class="carousel-img" loading="lazy" />
                    <img src="~/images/IMG_4896.JPG" alt="Slaapkamers, foto 4 van 4" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* ONTSPANNINGSKAMER *@
<section id="massage" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Ontspanningskamer</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Kies voor pure ontspanning met onze infraroodsauna, andullatiematras of boek een heerlijke massage.
            </p>
                <ul class="massage-grid mt-4">
                    <li class="massage-cell">
                        <span class="contact-label">Relax massage nek</span>
                        <div class="massage-meta">
                            <span>15 min.</span>
                            <strong>€ 20</strong>
                        </div>
                    </li>
                    <li class="massage-cell">
                        <span class="contact-label">Relax massage rug</span>
                        <div class="massage-meta">
                            <span>20 min.</span>
                            <strong>€ 25</strong>
                        </div>
                        <span class="massage-note">+ manuele therapie € 10</span>
                    </li>
                    <li class="massage-cell">
                        <span class="contact-label">Sportmassage benen</span>
                        <div class="massage-meta">
                            <span>20 min.</span>
                            <strong>€ 25</strong>
                        </div>
                    </li>
                    <li class="massage-cell">
                        <span class="contact-label">Voetreflexologie</span>
                        <div class="massage-meta">
                            <span>20 min.</span>
                            <strong>€ 30</strong>
                        </div>
                    </li>
                </ul>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/detente/IMG_4855.JPG" alt="Ontspanningskamer, foto 1 van 3" class="carousel-img active" />
                    <img src="~/images/detente/IMG_4859.JPG" alt="Ontspanningskamer, foto 2 van 3" class="carousel-img" loading="lazy" />
                    <img src="~/images/detente/IMG_4862.JPG" alt="Ontspanningskamer, foto 3 van 3" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

@* TUIN *@
<section id="garden" class="room-split-section full-bleed">
    <div class="row g-0 align-items-stretch">
        <div class="col-lg-6 room-info-side p-4 p-lg-5">
            <h2>Tuin</h2>
            <p class="mt-3 mt-lg-4 mb-0">
                Grote groene tuin met een ruim terras, ideaal om buiten te tafelen of te genieten van het zicht op de Ardense natuur.
            </p>
        </div>
        <div class="col-lg-6 room-media-side">
            <div class="room-carousel">
                <div class="carousel-track">
                    <img src="~/images/house/IMG_4781.JPG" alt="Tuin, foto 1 van 3" class="carousel-img active" />
                    <img src="~/images/house/IMG_4666.JPG" alt="Tuin, foto 2 van 3" class="carousel-img" loading="lazy" />
                    <img src="~/images/house/IMG_4791.JPG" alt="Tuin, foto 3 van 3" class="carousel-img" loading="lazy" />
                </div>
                <div class="carousel-controls">
                    <button type="button" class="carousel-btn prev-btn" aria-label="Vorige foto">‹</button>
                    <button type="button" class="carousel-btn next-btn" aria-label="Volgende foto">›</button>
                </div>
            </div>
        </div>
    </div>
</section>

