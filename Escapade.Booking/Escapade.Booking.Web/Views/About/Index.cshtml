@{
    ViewData["Title"] = "Het verblijf";
    ViewData["MetaDescription"] = "Ontdek de woonkamer, keuken, slaapkamers, ontspanningskamer, tuin en schuur van L'Escapade Ardennaise, een vakantiewoning voor groepen tot 10 personen in Rocquigny.";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4787.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4928.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4925.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/house/IMG_4794.JPG" alt="" />
        </div>

        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4787.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4928.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4925.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/house/IMG_4794.JPG" alt="" loading="lazy" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>VERBLIJF</h1>
    </div>
</section>

<section class="container intro-section">
    <p class="text-uppercase my-5 py-5 text-center">
        Een sfeervol toevluchtsoord waar rust, natuur en comfort samenkomen. Onze accommodatie biedt alle moderne 
        voorzieningen voor een onvergetelijk verblijf met familie of vrienden. Ontdek de verschillende ruimtes 
        van de woning en laat je meenemen door de warme sfeer van de Ardense omgeving.
    </p>
</section>

<section class="container text-center pb-5 mb-5">
    <nav class="d-flex justify-content-center gap-2 flex-wrap" aria-label="Ruimtes">
        <a href="#livingroom" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Woonkamer</a>
        <a href="#bathroom" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Badkamers</a>
        <a href="#kitchen" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Keuken</a>
        <a href="#bedroom" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Slaapkamers</a>
        <a href="#massage" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Ontspanningskamer</a>
        <a href="#garden" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Tuin</a>
        <a href="#farm" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Boerderij</a>
        <a href="#barn" class="btn btn-outline-dark btn-custom text-uppercase rounded-5">Schuur</a>
    </nav>
</section>

<div class="py-5 my-5"></div>

@* WOONKAMER *@
<section id="livingroom" class="room-split-section full-bleed border-top-1">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-6 room-info-side d-flex flex-column justify-content-between p-5">
                <div>
                    <h2>Woonkamer</h2>
                    <p class="mt-4">
                        Een ruime, sfeervolle woonkamer ingericht om samen te komen. Geniet van gezellige avonden bij de kachel of een goed boek in de comfortabele zithoek.
                    </p>
                </div>
            </div>
            <div class="col-lg-6 border-start-2">
                <div class="room-carousel">
                    <div class="carousel-track">
                        <img src="~/images/house/IMG_4794.JPG" alt="Woonkamer" class="carousel-img active" />
                        <img src="~/images/house/IMG_4918.JPG" alt="Woonkamer" class="carousel-img" loading="lazy" />
                        <img src="~/images/house/IMG_4793.JPG" alt="Woonkamer" class="carousel-img" loading="lazy" />
                    </div>
                    <div class="carousel-controls">
                        <button type="button" class="carousel-btn prev-btn" aria-label="Vorige">‹</button>
                        <button type="button" class="carousel-btn next-btn" aria-label="Volgende">›</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* BADKAMERS *@
<section id="bathroom" class="room-split-section full-bleed">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-6 room-info-side d-flex flex-column justify-content-between p-5">
                <div>
                    <h2>Badkamers</h2>
                    <p class="mt-4">
                        Moderne en verzorgde sanitairvoorzieningen uitgerust met alle comfort voor een verfrissende start van de dag.
                    </p>
                </div>
                <div class="pt-5">
                    <a asp-controller="Booking" asp-action="CreateBooking" class="custom-link">Vraag een verblijf aan</a>
                </div>
            </div>
            <div class="col-lg-6 border-start-2">
                <div class="room-carousel">
                    <div class="carousel-track">
                        <img src="~/images/house/IMG_4931.JPG" alt="Badkamer" class="carousel-img active" />
                        <img src="~/images/house/IMG_4836.JPG" alt="Badkamer" class="carousel-img" loading="lazy" />
                        <img src="~/images/house/IMG_4810.JPG" alt="Badkamer" class="carousel-img" loading="lazy" />
                    </div>
                    <div class="carousel-controls">
                        <button type="button" class="carousel-btn prev-btn" aria-label="Vorige">‹</button>
                        <button type="button" class="carousel-btn next-btn" aria-label="Volgende">›</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

