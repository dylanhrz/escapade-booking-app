@{
    ViewData["Title"] = "Rocquigny en omgeving | Winkels, restaurants en wandelen";
    ViewData["MetaDescription"] = "Alles in en rond Rocquigny: bakkers en supermarkten, restaurants en cafés, wandelroutes en uitstappen in de Franse Ardennen.";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/roquigny/IMG_4948.JPG" alt="Dorpszicht op Rocquigny" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_1871.jpg" alt="Landschap rond Rocquigny" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_1884.jpg" alt="Omgeving van Rocquigny" />
        </div>
        <div class="hero-image-item" style="max-width: 200px;">
            <img src="~/images/roquigny/IMG_0002.JPG" alt="Detail uit Rocquigny" />
        </div>

        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/roquigny/IMG_4948.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/roquigny/IMG_4944.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/IMG_1883.jpg" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/roquigny/IMG_0002.JPG" alt="" loading="lazy" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>ROCQUIGNY</h1>
    </div>
</section>

<section class="container intro-section">
    <p class="text-uppercase my-5 py-5 text-center">
        In en rond Rocquigny vind je alles voor een comfortabel verblijf. Van dagelijkse boodschappen en warme bakkers tot gezellige lokale restaurants, rustgevende natuurwandelingen en uitstappen in de regio.
    </p>
</section>

<section class="full-bleed border-top-1">
    <div class="info-split">
        <div class="info-split-photo">
            <img src="~/images/IMG_1884.jpg" alt="Dorpszicht op Rocquigny" loading="lazy" />
        </div>
        <div class="info-split-text">
            <h2>Winkels &amp; boodschappen</h2>
            <partial name="~/Views/Shared/Rocquigny/_Shops.cshtml" />
        </div>
    </div>
</section>

<section class="full-bleed border-top-1">
    <div class="info-split flip">
        <div class="info-split-photo">
            <img src="~/images/IMG_1871.jpg" alt="Landschap rond Rocquigny" loading="lazy" />
        </div>
        <div class="info-split-text">
            <h2>Eten &amp; drinken</h2>
            <partial name="~/Views/Shared/Rocquigny/_Food.cshtml" />
        </div>
    </div>
</section>

<section class="full-bleed border-top-1">
    <div class="info-split">
        <div class="info-split-photo">
            <img src="~/images/roquigny/IMG_4948.JPG" alt="Dorpszicht op Rocquigny" loading="lazy" />
        </div>
        <div class="info-split-text">
            <h2>Wandelen &amp; omgeving</h2>
            <partial name="~/Views/Shared/Rocquigny/_Nature.cshtml" />
        </div>
    </div>
</section>

<div class="full-bleed border-top-1"></div>

<section class="cta-section d-flex flex-column justify-content-center align-items-center">
    <div class="container">
        <div class="row mb-5 g-4 align-items-center">
            <div class="cta-section-content col-lg-12">
                <h2>
                    Verblijven in <br/>
                    L'Escapade Ardennaise?
                </h2>
                <p class="w-75 mx-auto">
                    Verblijven in een sfeervol toevluchtsoord in Rocquigny, omgeven door glooiende landschappen en
                    dorpscharme.
                </p>
                <a asp-controller="Booking"
                   asp-action="CreateBooking"
                   class="btn-grid">
                    Vraag je verblijf aan
                </a>
            </div>
        </div>
    </div>
</section>