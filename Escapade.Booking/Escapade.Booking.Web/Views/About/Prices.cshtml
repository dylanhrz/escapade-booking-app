@{
    ViewData["Title"] = "Tarieven | Prijzen voor 2, 3 of 7 nachten";
    ViewData["MetaDescription"] = "Tarieven van L'Escapade Ardennaise in Rocquigny: verblijf met maximaal 6 of 10 personen, vanaf 2 nachten tot een volledige week.";
}

<section class="container my-5 py-5">

    <article class="pricing-ticket pricing-ticket-dark" id="tot-10-personen">
        <div class="pricing-ticket-main">
            <h2>Tot 10 personen</h2>
            <p class="section-text">
                Ideaal voor grotere groepen, families of vrienden die het volledige verblijf optimaal willen benutten.
            </p>
            <a asp-controller="Booking" asp-action="CreateBooking" class="pricing-ticket-button">
                Boek voor 10 personen
            </a>
        </div>

        <div class="pricing-ticket-stub">
            <span class="contact-label">2 nachten</span>
            <span class="pricing-ticket-amount">€ 799</span>
        </div>
        <div class="pricing-ticket-stub">
            <span class="contact-label">3 nachten</span>
            <span class="pricing-ticket-amount">€ 995</span>
        </div>
        <div class="pricing-ticket-stub">
            <span class="contact-label">7 nachten / 1 week</span>
            <span class="pricing-ticket-amount">€ 1.995</span>
        </div>
    </article>

    <article class="pricing-ticket pricing-ticket-green" id="tot-6-personen">
        <div class="pricing-ticket-main">
            <h2>Tot 6 personen</h2>
            <p class="section-text">
                Perfect voor een intiemer gezelschap dat wil genieten van alle rust en ruimte in ons verblijf.
            </p>
            <a asp-controller="Booking" asp-action="CreateBooking" class="pricing-ticket-button">
                Boek voor 6 personen
            </a>
        </div>

        <div class="pricing-ticket-stub">
            <span class="contact-label">2 nachten</span>
            <span class="pricing-ticket-amount">€ 660</span>
        </div>
        <div class="pricing-ticket-stub">
            <span class="contact-label">3 nachten</span>
            <span class="pricing-ticket-amount">€ 850</span>
        </div>
        <div class="pricing-ticket-stub">
            <span class="contact-label">7 nachten / 1 week</span>
            <span class="pricing-ticket-amount">€ 1.495</span>
        </div>
    </article>

</section>