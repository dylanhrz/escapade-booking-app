@{
    ViewData["Title"] = "Faciliteiten | Sauna, tuin, keuken en parkeren";
    ViewData["MetaDescription"] = "Alle faciliteiten van L'Escapade Ardennaise in Rocquigny: volledig uitgeruste keuken, infraroodsauna, tuin met terras, gratis parkeren, wifi en meer.";

    var groups = new[]
    {
        new
        {
            Id = "keuken",
            Title = "Keuken & uitrusting",
            Intro = "Volledig uitgerust voor grote en kleine gezelschappen.",
            Items = new[]
            {
                "Gasfornuis & oven (meerdere ovenruimtes)",
                "2 koelkasten (waarvan 1 met diepvries)",
                "Vaatwasser, magnetron & klein oventje",
                "Koffiezetapparaat, Tassimo, waterkoker & broodrooster"
            }
        },
        new
        {
            Id = "wellness",
            Title = "Wellness & ontspanning",
            Intro = "Geniet van extra rust in onze ontspanningskamer.",
            Items = new[]
            {
                "Infraroodsauna",
                "Andullatiematras",
                "Houtkachel / haard (hout beschikbaar)",
                "Massages op aanvraag (nek-, rug-, sportmassage & voetreflexologie)"
            }
        },
        new
        {
            Id = "tuin",
            Title = "Tuin & terras",
            Intro = "Optimaal genieten van de buitenlucht en de rust.",
            Items = new[]
            {
                "Ruime tuin met terras & tuinmeubilair",
                "Terrasluifel",
                "Barbecue",
                "Waslijnen buiten"
            }
        },
        new
        {
            Id = "parkeren",
            Title = "Parkeren & garage",
            Intro = "Veilige opbergruimte en gratis parkeergelegenheid.",
            Items = new[]
            {
                "Gratis parkeren voor de deur en op het plein",
                "Afgesloten garage / schuur voor fietsen en motorfietsen"
            }
        },
        new
        {
            Id = "wassen",
            Title = "Wassen & verwarming",
            Intro = "Praktisch voor langere verblijven.",
            Items = new[]
            {
                "Wasmachine, droogkast & droogrek",
                "Centrale verwarming via pellets & warmtepomp"
            }
        },
        new
        {
            Id = "media",
            Title = "Media & extra comfort",
            Intro = "Alles aanwezig voor een comfortabel verblijf.",
            Items = new[]
            {
                "Gratis wifi (Livebox)",
                "TV Vlaanderen",
                "Extra beddengoed, dekens en kussens aanwezig",
                "Rookmelders & brandblusser aanwezig"
            }
        }
    };
}

<section class="page-header container">
    <span class="contact-label mb-3">L'Escapade Ardennaise</span>
    <h1>Faciliteiten</h1>
    <p>
        Ontdek al het comfort en de voorzieningen die L'Escapade Ardennaise biedt voor een zorgeloos en ontspannen verblijf.
    </p>
</section>

<section class="full-bleed border-top-1 border-bottom-1">
    <div class="container">
        <div class="facility-grid border-start-1 border-end-1">
            @foreach (var group in groups)
            {
                <article class="facility-card" id="@group.Id">
                    <h2>@group.Title</h2>
                    <p>@group.Intro</p>
                    <ul>
                        @foreach (var item in group.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<section class="cta-section d-flex flex-column justify-content-center align-items-center">
    <div class="container">
        <div class="row mb-5 g-4 align-items-center">
            <div class="cta-section-content col-lg-12">
                <h2>Plan je verblijf</h2>
                <p class="w-75 mx-auto">
                    Kies je periode en stuur je aanvraag. De eigenaars nemen daarna persoonlijk contact met je op.
                </p>
                <a asp-controller="Booking" asp-action="CreateBooking" class="btn-grid">Vraag je verblijf aan</a>
            </div>
        </div>
    </div>
</section>