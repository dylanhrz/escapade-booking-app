@{
    ViewData["Title"] = "Kamers";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/evasion/IMG_4816.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4871.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4877.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4899.JPG" alt="" />
        </div>

        <div class="hero-image-item">
            <img src="~/images/evasion/IMG_4816.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4871.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4877.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4899.JPG" alt="" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>@ViewData["Title"]</h1>
    </div>
</section>

<section class="container intro-section">
    <p class="text-uppercase my-5 py-5 text-center">
        L’Escapade Ardennaise beschikt over sfeervolle slaapkamers geschikt voor groepen tot 10 personen. 
        Alle gasten hebben tijdens hun verblijf toegang tot de grote tuin met terras, de infraroodsauna en 
        de ontspanningsruimte. 's Morgens kunt u in alle rust genieten van een vers ontbijt van de lokale bakker 
        met zicht op de groene omgeving.
    </p>
</section>

<!-- Chambre du cycliste -->
<section class="rooms-accordion-section full-bleed">
    <div class="accordion-item container">
        <button class="accordion-header px-0" type="button" aria-expanded="false">
            <div class="room-titles">
                <h2 class="text-uppercase">Chambre du cycliste</h2>
                <span class="text-decoration-underline">1e verdiep / 2 persoonsbed / 1 persoonsbed</span>
            </div>
            <span class="accordion-icon"></span>
        </button>

        <div class="accordion-content">
            <div class="room-detail-grid">
                
                <div class="room-gallery">
                    <div class="image-wrapper">
                        <img src="~/images/cycliste/IMG_4883.JPG" alt="Chambre du cycliste" class="active"/>
                        <img src="~/images/cycliste/IMG_4873.JPG" alt="Chambre du cycliste" />
                        <img src="~/images/cycliste/IMG_4875.JPG" alt="Chambre du cycliste" />
                        <img src="~/images/cycliste/IMG_4879.JPG" alt="Chambre du cycliste" />
                        <img src="~/images/cycliste/IMG_4877.JPG" alt="Chambre du cycliste" />
                        
                        <img src="~/images/cycliste/IMG_4880.JPG" alt="Chambre du cycliste" />
                        
                        
                        <button class="slider-btn prev-btn" aria-label="Vorige afbeelding">‹</button>
                        <button class="slider-btn next-btn" aria-label="Volgende afbeelding">›</button>
                    </div>
                </div>

                <div class="room-info">
                    <p>
                        Deze ruime en karaktervolle slaapkamer op de eerste verdieping is sfeervol ingericht met 
                        een subtiel fietsthema en beschikt over een comfortabel tweepersoonsbed. 
                        Een ideale, rustgevende plek voor een aangenaam en ontspannen verblijf.
                    </p>
                    <div>
                        <h3>Voorzieningen</h3>
                        <div>
                            <div class="room-info-col">
                                <span>1e verdiep</span>
                                <span>3 persoonskamer</span>
                                <span>Tweepersoonsbed</span>
                                <span>Eenpersoonsbed</span>
                                <span>Ingekleed in een fiets thema</span>
                                <span>Centrale verwarming</span>
                                <span>Rolluiken</span>
                                <span>Gordijnen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

