@{
    ViewData["Title"] = "Kamers";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/evasion/IMG_4816.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4850.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4877.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4899.JPG" alt="" />
        </div>

        <div class="hero-image-item">
            <img src="~/images/IMG_4816.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4850.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4877.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4899.JPG" alt="" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>KAMERS</h1>
    </div>
</section>

<section class="container">
    <p class="text-uppercase my-5 py-5">
        L’Escapade Ardennaise beschikt over sfeervolle slaapkamers geschikt voor groepen tot 10 personen. 
        Alle gasten hebben tijdens hun verblijf toegang tot de grote tuin met terras, de infraroodsauna en 
        de ontspanningsruimte. 's Morgens kunt u in alle rust genieten van een vers ontbijt van de lokale bakker 
        met zicht op de groene omgeving.
    </p>
</section>

<section class="rooms-accordion-section full-bleed">
    <div class="accordion-item container">
        <button class="accordion-header px-0" type="button" aria-expanded="false">
            <div class="room-titles">
                <h2>Chambre d'évasion</h2>
                <span class="text-uppercase">Gelijkvloers / Tweepersoonsbed</span>
            </div>
            <span class="accordion-icon"></span>
        </button>

        <div class="accordion-content">
            <div class="room-detail-grid">
                
                <div class="room-gallery">
                    <div class="image-wrapper">
                        <img src="~/images/evasion/IMG_4819.JPG" alt="Chambre d'évasion" class="active" />
                        <img src="~/images/evasion/IMG_4820.JPG" alt="Chambre d'évasion" />
                        <img src="~/images/evasion/IMG_4821.JPG" alt="Chambre d'évasion" />
                        <img src="~/images/evasion/IMG_4816.JPG" alt="Chambre d'évasion" />
        
                        <button class="slider-btn prev-btn" aria-label="Vorige afbeelding">‹</button>
                        <button class="slider-btn next-btn" aria-label="Volgende afbeelding">›</button>
                    </div>
                </div>

                <div class="room-info">
                    <p>
                        Deze ruime slaapkamer op het gelijkvloers is voorzien van een comfortabel tweepersoonsbed en biedt direct zicht op het dorpsplein.
                    </p>
                    
                    <div>
                        <h3>Voorzieningen</h3>
                        <div>
                            <div class="room-info-col">
                                <span>Gelijkvloers</span>
                                <span>2 persoonskamer</span>
                                <span>Tweepersoonsbed</span>
                                <span>Kleerkasten</span>
                                <span>Centrale verwarming</span>
                                <span>Rolluiken</span>
                                <span>Gordijnen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="rooms-accordion-section full-bleed">
    <div class="accordion-item container">
        <button class="accordion-header px-0" type="button" aria-expanded="false">
            <div class="room-titles">
                <h2>Chambre des rêves</h2>
                <span class="text-uppercase">1e verdiep / Tweepersoonsbed & babybedje</span>
            </div>
            <span class="accordion-icon"></span>
        </button>

        <div class="accordion-content">
            <div class="room-detail-grid">
                
                <div class="room-gallery">
                    <div class="image-wrapper">
                        <img src="~/images/reves/IMG_4844.JPG" alt="Chambre des rêves" class="active" />
                        <img src="~/images/reves/IMG_4847.JPG" alt="Chambre des rêves" />
                        <img src="~/images/reves/IMG_4851.JPG" alt="Chambre des rêves" />
                        <img src="~/images/reves/IMG_4845.JPG" alt="Chambre des rêves" />
        
                        <button class="slider-btn prev-btn" aria-label="Vorige afbeelding">‹</button>
                        <button class="slider-btn next-btn" aria-label="Volgende afbeelding">›</button>
                    </div>
                </div>

                <div class="room-info">
                    <p>
                        Deze ruime slaapkamer op de eerste verdieping beschikt over een comfortabel tweepersoonsbed en
                        een gezellig babybedje. Een ideale en rustgevende plek voor een verblijf met een kleintje.     
                        </p>
                    <div>
                        <h3>Voorzieningen</h3>
                        <div>
                            <div class="room-info-col">
                                <span>Gelijkvloers</span>
                                <span>2 persoonskamer</span>
                                <span>Tweepersoonsbed</span>
                                <span>Kinderbedje</span>
                                <span>Kleerkasten</span>
                                <span>Centrale verwarming</span>
                                <span>Rolluiken</span>
                                <span>Gordijnen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>