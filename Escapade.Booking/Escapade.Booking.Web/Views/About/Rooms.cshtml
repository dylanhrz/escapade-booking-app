@{
    ViewData["Title"] = "Kamers | Slaapkamers voor groepen tot 10 personen";
    ViewData["MetaDescription"] = "Bekijk de slaapkamers en de ontspanningskamer van L'Escapade Ardennaise in Rocquigny: sfeervolle kamers voor groepen tot 10 personen, met infraroodsauna en grote tuin.";
}

<section class="rooms-hero-container full-bleed">
    <div class="hero-carousel-track">
        <div class="hero-image-item">
            <img src="~/images/evasion/IMG_4816.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4871.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4877.JPG" alt="" />
        </div>
        <div class="hero-image-item">
            <img src="~/images/IMG_4899.JPG" alt="" />
        </div>

        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/evasion/IMG_4816.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/IMG_4871.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/IMG_4877.JPG" alt="" loading="lazy" />
        </div>
        <div class="hero-image-item" aria-hidden="true">
            <img src="~/images/IMG_4899.JPG" alt="" loading="lazy" />
        </div>
    </div>

    <div class="hero-text-overlay">
        <h1>Kamers</h1>
    </div>
</section>

<nav class="room-overview full-bleed border-top-1 border-bottom-1" aria-label="Overzicht van de kamers">
    <ul>
        <li>
            <a href="#cycliste">
                <span class="contact-label">1e verdiep</span>
                <strong lang="fr">Chambre du cycliste</strong>
                <span class="room-overview-meta">3 personen</span>
            </a>
        </li>
        <li>
            <a href="#evasion">
                <span class="contact-label">Gelijkvloers</span>
                <strong lang="fr">Chambre d'évasion</strong>
                <span class="room-overview-meta">2 personen</span>
            </a>
        </li>
        <li>
            <a href="#reves">
                <span class="contact-label">1e verdiep</span>
                <strong lang="fr">Chambre des rêves</strong>
                <span class="room-overview-meta">2 personen + babybedje</span>
            </a>
        </li>
        <li>
            <a href="#nature">
                <span class="contact-label">1e verdiep</span>
                <strong lang="fr">Chambre de la nature</strong>
                <span class="room-overview-meta">2 personen</span>
            </a>
        </li>
        <li>
            <a href="#detente">
                <span class="contact-label">1e verdiep</span>
                <strong lang="fr">Chambre de détente</strong>
                <span class="room-overview-meta">Sauna & ontspanning</span>
            </a>
        </li>
        <li>
            <a href="#douillette">
                <span class="contact-label">1e verdiep</span>
                <strong lang="fr">Chambre douillette</strong>
                <span class="room-overview-meta">2 personen</span>
            </a>
        </li>
    </ul>
</nav>

<section class="container intro-section">
    <p class="text-center">
        L’Escapade Ardennaise beschikt over sfeervolle slaapkamers voor groepen tot 10 personen.
        Alle gasten hebben toegang tot de grote tuin met terras, de infraroodsauna en de ontspanningsruimte.
        's Morgens geniet je in alle rust van een vers ontbijt van de lokale bakker, met zicht op het groen.
    </p>
</section>

@* CHAMBRE DU CYCLISTE *@
<section id="cycliste" class="rooms-accordion-section full-bleed">
    <div class="accordion-item container">
        <button class="accordion-header px-0" type="button" aria-expanded="false" aria-controls="room-cycliste">
            <div class="room-titles">
                <h2 lang="fr">Chambre du cycliste</h2>
                <span class="room-subtitle">1e verdiep / Tweepersoonsbed / Eénpersoonsbed</span>
            </div>
            <span class="accordion-icon" aria-hidden="true"></span>
        </button>

        <div class="accordion-content" id="room-cycliste">
            <div class="room-detail-grid">

                <div class="room-gallery">
                    <div class="image-wrapper">
                        <img src="~/images/cycliste/IMG_4883.JPG" alt="Chambre du cycliste, foto 1 van 6" class="active" />
                        <img src="~/images/cycliste/IMG_4873.JPG" alt="Chambre du cycliste, foto 2 van 6" loading="lazy" />
                        <img src="~/images/cycliste/IMG_4875.JPG" alt="Chambre du cycliste, foto 3 van 6" loading="lazy" />
                        <img src="~/images/cycliste/IMG_4879.JPG" alt="Chambre du cycliste, foto 4 van 6" loading="lazy" />
                        <img src="~/images/cycliste/IMG_4877.JPG" alt="Chambre du cycliste, foto 5 van 6" loading="lazy" />
                        <img src="~/images/cycliste/IMG_4880.JPG" alt="Chambre du cycliste, foto 6 van 6" loading="lazy" />

                        <button type="button" class="slider-btn prev-btn" aria-label="Vorige afbeelding">‹</button>
                        <button type="button" class="slider-btn next-btn" aria-label="Volgende afbeelding">›</button>
                    </div>
                </div>

                <div class="room-info">
                    <p>
                        Deze ruime en karaktervolle slaapkamer op de eerste verdieping is sfeervol ingericht met
                        een subtiel fietsthema en beschikt over een comfortabel tweepersoonsbed.
                        Een ideale, rustgevende plek voor een aangenaam en ontspannen verblijf.
                    </p>
                    <div>
                        <h3>Voorzieningen</h3>
                        <div>
                            <div class="room-info-col">
                                <span>1e verdiep</span>
                                <span>3 persoonskamer</span>
                                <span>Tweepersoonsbed</span>
                                <span>Eenpersoonsbed</span>
                                <span>Ingekleed in een fiets thema</span>
                                <span>Centrale verwarming</span>
                                <span>Rolluiken</span>
                                <span>Gordijnen</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

