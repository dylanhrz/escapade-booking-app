@{
    ViewData["Title"] = "Contact";
}

<section class="full-bleed">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">
            
            <div class="col-12 p-5 border-bottom border-dark">
                <h1 class="display-4 text-uppercase m-0">Contacteer ons</h1>
            </div>

            <div class="col-lg-4 d-flex flex-column border-end border-dark">
                <div class="w-100 flex-grow-1 min-vh-50 position-relative">
                    <iframe
                        src="https://maps.google.com/maps?q=20+Place+Jean+Mermoz,+08220+Rocquigny,+France&hl=nl&z=16&iwloc=near&output=embed"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="border-0 w-100 h-100 position-absolute top-0 start-0">
                    </iframe>
                </div>

                <div class="p-4 p-md-5 border-top border-dark">
                    <span class="fw-bold text-uppercase small d-block mb-1">Adres</span>
                    <h4 class="h3 mb-0">
                        <a href="https://www.google.com/maps/search/?api=1&query=20+Place+Jean+Mermoz,+08220+Rocquigny,+France"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="text-dark text-decoration-none custom-hover">
                            20 Place Jean Mermoz, 08220 Rocquigny <br/> France
                        </a>
                    </h4>
                </div>
            </div>

            <div class="col-lg-8 p-4 p-md-5 d-flex flex-column gap-5">

                <div>
                    <span class="fw-bold text-uppercase small">Eigenares</span>
                    <h3 class="h1 mb-3">Wendy Martens</h3>
                    <p class="mb-0 fs-4">
                        Welkom in Rocquigny. Als lokaal bekende in de regio wijs ik je graag de weg naar de mooiste beklimmingen,
                        rustige wegen en verborgen paadjes van de Franse Ardennen. Of je nu komt voor een intensief trainingsweekend
                        of een ontspannen uitvalbasis zoekt met de familie: we zorgen dat alles tot in de puntjes geregeld is
                        voor jou en je materiaal.
                    </p>
                </div>

                <div>
                    <span class="fw-bold text-uppercase small">Telefoon</span>
                    <h3 class="h1 mb-0">
                        <a href="tel:+33673081169" class="text-dark text-decoration-none custom-hover">
                            +33 6 730 811 69
                        </a>
                    </h3>
                </div>

                <div>
                    <span class="fw-bold text-uppercase small">E-mail</span>
                    <h3 class="h1 mb-0">
                        <a href="mailto:wendymartens19@gmail.com"
                           class="text-dark text-decoration-none custom-hover">
                            wendymartens19@gmail.com
                        </a>
                    </h3>
                </div>

            </div>

        </div>
    </div>
</section>