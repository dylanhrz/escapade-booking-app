@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="intro-section mt-5 min-vh-50 d-flex align-items-center">
    <div class="title-section text-center w-100">
        <p class="w-100 mx-auto">
            Heb je een vraag over een verblijf, wil je de beschikbaarheid controleren of heb je een speciaal verzoek? Neem gerust contact met ons op, we helpen je graag verder.
        </p>    
    </div>
</section>

<section class="my-5 py-5">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-4 d-flex flex-column border-1">
                <div class="w-100 flex-grow-1 min-vh-50 position-relative">
                    <iframe
                        src="https://maps.google.com/maps?q=20+Place+Jean+Mermoz,+08220+Rocquigny,+France&hl=@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName&z=16&iwloc=near&output=embed"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="border-0 w-100 h-100 position-absolute top-0 start-0">
                    </iframe>
                </div>
            </div>
            
            <div class="col-lg-1"></div>

            <div class="col-lg-7 contact-section d-flex flex-column gap-5 mt-5">
                
                <div>
                    <span class="contact-label">@Localizer["LabelOwner"]</span>
                    <h3 class="contact-heading mt-2">
                        Hans Roos & Wendy Martens
                    </h3>
                </div>

                <div>
                    <span class="contact-label">@Localizer["LabelAddress"]</span>
                    <h3 class="contact-heading mt-2">
                        <a href="https://www.google.com/maps/search/?api=1&query=20+Place+Jean+Mermoz,+08220+Rocquigny,+France"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="contact-link"
                           data-text="20 PLACE JEAN MERMOZ, 08220 ROCQUIGNY, FRANCE">
                            <span>
                                20 PLACE JEAN MERMOZ <br/>
                                08220 ROCQUIGNY <br/>
                                FRANCE
                            </span>
                        </a>
                    </h3>
                </div>

                <div>
                    <span class="contact-label">@Localizer["LabelPhone"]</span>
                    <h3 class="contact-heading mt-2">
                        <a href="tel:+33673081169" class="contact-link" data-text="+33 6 730 811 69">
                            <span>+33 6 730 811 69</span>
                        </a>
                        <br class="mt-3" />
                        <a href="tel:+32495610454" class="contact-link" data-text="+32 4 956 104 54">
                            <span>+32 4 956 104 54</span>
                        </a>
                    </h3>
                </div>

                <div>
                    <span class="contact-label">@Localizer["LabelEmail"]</span>
                    <h3 class="contact-heading mt-2">
                        <a href="mailto:wendymartens19@gmail.com" class="contact-link" data-text="WENDYMARTENS19@GMAIL.COM">
                            <span>WENDYMARTENS19@GMAIL.COM</span>
                        </a>
                    </h3>
                </div>
            </div>

        </div>
    </div>
</section>