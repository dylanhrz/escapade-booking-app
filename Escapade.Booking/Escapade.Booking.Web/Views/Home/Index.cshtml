@{
    ViewData["Title"] = "L'Escapade Ardennaise";
}

<div id="hero-banner" class="position-relative d-flex flex-column justify-content-center align-items-center text-center text-white px-3 overflow-hidden">
    
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/dummy-hero-video.mp4")" type="video/mp4"/>
        Je browser ondersteunt geen videotag.
    </video>

    <div class="hero-overlay"></div>
    
    <div class="hero-card-container position-absolute top-0 start-0 p-3 p-md-5 w-100 h-100 d-flex align-items-start pointer-events-none">
        <div class="hero-card p-4 text-start">
            <span class="text-uppercase fw-bold sub-heading d-block mb-2">L'Escapade Ardennaise</span>
            
            <h1 class="font-non-serif fw-bold lh-1 mb-3 card-title text-lowercase">
                rust in de <br/>franse ardennen.
            </h1>

            <p class="card-text mb-4">
                Een hedendaags verblijf midden in de natuur. Kom tot rust, ontdek de bossen en geniet van de stilte.
            </p>

            <a asp-controller="Booking"
               asp-action="NewBooking"
               class="btn-link text-uppercase fw-bold text-decoration-none d-inline-block">
                <i class="bi bi-calendar-check me-1"></i>
                Vraag je verblijf aan
            </a>
        </div>
    </div>
    
</div>