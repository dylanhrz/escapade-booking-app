@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="full-bleed position-relative overflow-hidden hero-banner border-start-1 border-end-1">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/dummy-hero-video.mp4")" type="video/mp4"/>
        @Localizer["VideoNotSupported"]
    </video>

    <div class="hero-overlay"></div>

    <div class="container position-relative">
        <div class="hero-cta-col">
            <div class="p-5">
                <h3 class="split-section-head text-center">
                    <span class="text-highlight"> Rocquigny, </span> <br />
                    @Localizer["HeroSubtitle"]
                </h3>

                <div class="d-flex align-items-center justify-content-center gap-5 mt-5">
                    <h3 class="hero-link-heading m-0">
                        <a asp-controller="Home"
                           asp-action="About"
                           class="hero-link"
                           data-text="@Localizer["Verkennen"]">
                            <span>@Localizer["Verkennen"]</span>
                        </a>
                    </h3>

                    <h3 class="hero-link-heading m-0">
                        <a asp-controller="Booking"
                           asp-action="CreateBooking"
                           class="hero-link"
                           data-text="@Localizer["Aanvragen"]">
                            <span>@Localizer["Aanvragen"]</span>
                        </a>
                    </h3>
                </div>
            </div>
        </div>
    </div>
</section>