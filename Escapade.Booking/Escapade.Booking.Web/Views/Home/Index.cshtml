@{
    ViewData["Title"] = "L'Escapade Ardennaise";
}

<div class="py-5 my-5">
    <h1 class="display-3 fw-bold">@ViewData["Title"]</h1>
    <p>Een rustpunt in het hart van de Franse Ardennen</p>
    
    <a asp-controller="Booking" 
       asp-action="NewBooking" 
       class="btn border border-dark rounded-pill px-4 py-2 text-dark text-decoration-none btn-custom-hover">
        <i class="bi bi-calendar-check"></i>
        Reserveer je verblijf
    </a>
</div>