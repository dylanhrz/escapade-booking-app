@{
    ViewData["Title"] = "Home";
}

<div id="hero-banner" class="position-relative d-flex flex-column justify-content-center align-items-center text-center text-white px-3 overflow-hidden">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/dummy-hero-video.mp4")" type="video/mp4"/>
        Je browser ondersteunt geen videotag.
    </video>

    <div class="hero-overlay"></div>
    
    <div class="m-5">

        <div class="hero-card px-4 py-3">
            <a asp-controller="Booking"
               asp-action="NewBooking"
               class="text-dark custom-hover text-uppercase fw-bold text-decoration-none d-inline-block stretched-link">
                Vraag je verblijf aan
            </a>
        </div>
        
    </div>
</div>

<section class="full-bleed position-relative">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-6 d-flex align-items-center p-5 section-border-end">
                <div class="pe-lg-4">
                    <p class="split-section-text mb-0 fw-medium">
                        Geniet van een rustgevend verblijf in het hart van de franse ardennen. Onze vakantiewoning biedt
                        <span class="text-highlight">de perfecte uitvalbasis voor wie wil ontspannen in de natuur.</span> 
                        Van wandelingen in het bos tot gezellige avonden, wij geloven dat 
                        <span class="text-highlight">comfort en gastvrijheid</span>
                        hand in hand gaan.
                    </p>
                </div>
            </div>

            <div class="col-lg-6 position-relative min-vh-50">
                <iframe
                    src="https://maps.google.com/maps?q=20%20Place%20Jean%20Mermoz,%2008220%20Rocquigny,%20France&t=&z=16&ie=UTF8&iwloc=&output=embed"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="border-0 w-100 h-100 position-absolute top-0 start-0">
                </iframe>
            </div>

        </div>
    </div>
</section>


