@{
    ViewData["Title"] = "L'Escapade Ardennaise";
}

<div id="hero-banner" class="d-flex flex-column justify-content-center align-items-center text-center text-white px-3">
    <h1 class="hero-title text-uppercase mb-4">
        Rust in de <br />
        Franse Ardennen
