@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="hero-banner full-bleed position-relative overflow-hidden min-vh-100 d-flex flex-column justify-content-between py-5">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/cows-video-2.mp4")" type="video/mp4"/>
        @Localizer["VideoNotSupported"]
    </video>

    <div class="hero-overlay"></div>
    
    <div class="container position-relative z-3 py-5">
        <div class="row justify-content-end align-items-start">
            <div class="col-12 col-md-6 col-lg-5">
                
                <div class="hero-cta-col text-light text-uppercase">
                    <p class="hero-text mb-0">
                        L’Escapade Ardennaise is meer dan zomaar een rustgevend verblijf, een toevluchtsoord in het hart van Rocquigny, omgeven door landschappen en dorpscharme.
                    </p>
                    <p class="hero-text mt-3 mb-0">
                        Vlot bereikbaar en toch verwijderd van de dagelijkse drukte, biedt het de balans tussen natuur, comfort en lokale sfeer. Met authentieke bistro’s, ambachtelijke bakkers en historische dorpen vlakbij, is het de ideale plek voor ontspanning, focus en een verfrissend ander tempo.
                    </p>
                </div>
                
                <div class="hero-cta">
                    <a asp-controller="Booking" 
                       asp-action="CreateBooking">Vraag je verblijf aan</a>
                </div>
            </div>
        </div>
        
    </div>
    
</section>

<section class="py-5 my-5 d-flex flex-column justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="container-fluid px-4">
        <div class="row mb-5">
            <div class="col-12">
                <h3 class="mb-4 font-non-serif">
                    Rust in de Franse Ardennen
                </h3>
                <p class="text-uppercase mb-5">
                    L’Escapade Ardennaise is een idyllische vakantiewoning met een unieke, rustgevende ligging aan
                    de Place Jean Mermoz in het schilderachtige Franse Rocquigny.
                    Je verblijft er in het hart van de Franse Ardennen, omgeven door glooiende landschappen en
                    op een boogscheut van gezellige lokale bakkers, authentieke bistro’s en historische dorpen.
                </p>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="img-container" onclick="openLightbox('@Url.Content("~/images/IMG_4624.JPG")')">
                    <img src="~/images/IMG_4624.JPG"
                         alt="L'Escapade Ardennaise"
                         class="grid-img"/>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="img-container" onclick="openLightbox('@Url.Content("~/images/IMG_4658.JPG")')">
                    <img src="~/images/IMG_4658.JPG"
                         alt="L'Escapade Ardennaise"
                         class="grid-img"/>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="img-container" onclick="openLightbox('@Url.Content("~/images/IMG_4653.JPG")')">
                    <img src="~/images/IMG_4653.JPG"
                         alt="L'Escapade Ardennaise"
                         class="grid-img"/>
                </div>
            </div>
        </div>

        <div id="custom-cursor">BEKIJK</div>

        <dialog id="lightbox" onclick="this.close()">
            <img id="lightbox-img" src="" alt="Full view"/>
        </dialog>
    </div>
</section>

<section class="py-5 my-5 d-flex flex-column justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="container-fluid px-4">
        <div class="row mb-5 g-5">
            <div class="col-lg-7">
                <img src="~/images/IMG_4945.JPG"
                     style="width: 100%"
                     alt="L'Escapade Ardennaise" />
            </div>
            
            <div class="col-lg-5 align-self-center">
                <h3 class="mb-4 font-non-serif">
                    Ontdek Rocquigny & de Franse Ardennen
                </h3>
                <p class="text-uppercase mb-5">
                    Rocquigny en het omliggende Ardeense landschap bieden een heerlijke mix van rust, natuur en
                    authentieke Franse dorpscharme. Trek eropuit voor een ontspannende boswandeling,
                    verken de streek op de fiets of ontdek historische stadjes en lokale streekspecialiteiten.
                    Laat je betoveren door de omgeving en word, net zoals wij, verliefd op deze prachtige plek!
                </p>

                <div>
                    <a asp-controller=""
                       asp-action=""
                       class="btn btn-outline-dark text-uppercase px-4 py-2 border-1 rounded-0">
                        Ontdek Rocquigny
                    </a>
                </div>
            </div>    
        </div>
    </div>
</section>

