@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="hero-banner full-bleed position-relative overflow-hidden min-vh-100 d-flex flex-column justify-content-between pb-5">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/cows-video-2.mp4")" type="video/mp4"/>
        @Localizer["VideoNotSupported"]
    </video>

    <div class="hero-overlay"></div>
    
    <div class="container position-relative z-3 my-auto my-md-0 mt-md-auto py-5">
        <div class="row justify-content-end align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="hero-cta-col text-light text-uppercase">
                    <p class="hero-text mb-0">
                        Galicia is more than just a stunning setting; it's a region with deep roots, vibrant culture and a warm, welcoming community.
                    </p>
                    <p class="hero-text mt-3 mb-0">
                        The nearest airport is only 1h away. Once you arrive, you’ll find a region where nature and innovation go hand in hand. With its rugged coastline, lush forests and strong traditions, it’s an ideal setting for focused work and a refreshing change of pace from city life.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 mt-5">
    <div class="container-fluid px-4">
        <div class="row mb-5">
            <div class="col-12">
                <h3 class="mb-3 font-non-serif">
                    Rust in de Franse Ardennen
                </h3>
                <p class="text-uppercase mb-4">
                    L’Escapade Ardennaise is een idyllische vakantiewoning met een unieke, rustgevende ligging aan
                    de Place Jean Mermoz in het schilderachtige Franse Rocquigny. 
                    Je verblijft er in het hart van de Franse Ardennen, omgeven door glooiende landschappen en 
                    op een boogscheut van gezellige lokale bakkers, authentieke bistro’s en historische dorpen.        
                </p>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4624.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>
            
            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4658.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4653.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>
        </div>
    </div>
</section>