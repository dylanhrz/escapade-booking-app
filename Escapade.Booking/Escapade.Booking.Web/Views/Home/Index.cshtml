@{
    ViewData["Title"] = "Home";
}

<section class="full-bleed position-relative overflow-hidden hero-banner border-start-2 border-end-2">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/dummy-hero-video.mp4")" type="video/mp4"/>
        Je browser ondersteunt geen videotag.
    </video>

    <div class="hero-overlay"></div>

    <div class="container position-relative" style="z-index: 3;">
        <div class="hero-cta-col">
            <div class="p-5">
                <h3 class="split-section-head text-center">
                    Het dorpsplein van het rustieke <span class="text-highlight">Rocquigny,</span> <br />
                    ver weg van de dagelijkse drukte. 
                </h3>

                <a asp-controller="Booking"
                   asp-action="CreateBooking"
                   class="nav-block-btn hero-cta-btn text-uppercase text-decoration-none mt-4">
                    Vraag je verblijf aan
                </a>
            </div>
        </div>
    </div>
</section>

<section class="position-relative">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch border-end-2">

            <div class="col-lg-6 d-flex align-items-center p-5 section-border-end">
                <div class="pe-lg-4">
                    <h3 class="split-section-text mb-0">
                        Geniet van een rustgevend verblijf in het hart van de franse ardennen. 
                        <br />
                        Onze woning biedt
                        <span class="text-highlight">de perfecte uitvalbasis voor wie even van tussenuit wil in de natuur.</span>
                    </h3>
                </div>
            </div>

            <div class="col-lg-6 position-relative min-vh-50">
                <iframe
                    src="https://maps.google.com/maps?q=20%20Place%20Jean%20Mermoz,%2008220%20Rocquigny,%20France&t=&z=16&ie=UTF8&iwloc=&output=embed"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="border-0 w-100 h-100 position-absolute top-0 start-0">
                </iframe>
            </div>
        </div>
    </div>
</section>

<section class="position-relative">
        <div class="row g-0">
            <a asp-controller="Booking"
               asp-action="CreateBooking"
               class="nav-block-btn hero-cta-btn-full-width text-uppercase fw-bold text-decoration-none border-bottom-0">
                Vraag je verblijf aan
            </a>
        </div>
</section>