@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="full-bleed position-relative overflow-hidden hero-banner min-vh-100 d-flex align-items-end pb-5">
    <video autoplay loop muted playsinline id="hero-video">
        <source src="@Url.Content("~/videos/dummy-hero-video.mp4")" type="video/mp4"/>
        @Localizer["VideoNotSupported"]
    </video>

    <div class="hero-overlay"></div>

    <div class="container position-relative">
        <div class="hero-cta-col d-flex flex-column align-items-start">
            <h2 class="head-center mb-4">
                @Localizer["Title"]
            </h2>     
            <a asp-controller="Booking"
               asp-action="CreateBooking"
               target="_blank"
               rel="noopener noreferrer"
               class="hero-btn">
                Vraag je verblijf aan
            </a>
        </div>
    </div>
</section>

<section class="py-5 mt-5">
    <div class="container-fluid px-4">
        <div class="row mb-5">
            <div class="col-12">
                <h3 class="mb-3 font-non-serif">
                    Rust in de Franse Ardennen
                </h3>
                <p class="text-uppercase mb-4">
                    L’Escapade Ardennaise is een idyllische vakantiewoning met een unieke, rustgevende ligging aan
                    de Place Jean Mermoz in het schilderachtige Franse Rocquigny. 
                    Je verblijft er in het hart van de Franse Ardennen, omgeven door glooiende landschappen en 
                    op een boogscheut van gezellige lokale bakkers, authentieke bistro’s en historische dorpen.        
                </p>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4624.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>
            
            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4658.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <img src="~/images/IMG_4653.JPG" alt="L'Escapade Ardennaise" class="grid-img" />
            </div>
        </div>
    </div>
</section>