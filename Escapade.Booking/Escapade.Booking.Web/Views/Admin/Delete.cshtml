@model AdminDeleteBookingViewModel

@{
    ViewData["Title"] = "Boeking Verwijderen";
}

<section class="section-header border-bottom-1 text-center py-5 border-start-1 border-end-1">
    <div class="px-3">
        <p class="text-uppercase fw-bold small text-danger mb-2">Beheerdersactie / Onomkeerbaar</p>
        <h1 class="display-5 font-serif text-uppercase fw-bold m-0">Boeking Verwijderen</h1>
    </div>
</section>

<section class="border-bottom-1 border-start-1 border-end-1">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-7 border-end-1 p-4 p-lg-5 d-flex flex-column justify-content-between">
                <div>
                    
                    <p class="info-label mb-4">
                        Weet u zeker dat u deze boeking wilt verwijderen? Deze actie verwijdert de boeking definitief uit het systeem en kan niet ongedaan worden gemaakt.
                    </p>
                    
                    <h2 class="display-6 font-non-serif text-uppercase fw-bold mb-4">
                       
                    </h2>
                    
                    <span class="info-label text-uppercase">Naam</span>
                    <h3 class="info-head text-uppercase mt-2">
                        @Model.Name
                    </h3>

                    <div class="border-1 ps-3 py-2 my-4">
                        <p class="text-uppercase info-label mb-1">Gereserveerde Periode</p>
                        <p class="h4 font-monospace m-0">
                            @Model.StartDate?.ToString("dd/MM/yyyy") — @Model.EndDate?.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 p-4 p-lg-5 d-flex flex-column justify-content-center">
                <form asp-controller="Admin" asp-action="Delete" method="post" class="w-100">
                    <input type="hidden" asp-for="Id"/>

                    <div class="d-flex flex-column gap-3">
                        <button type="submit"
                                class="custom-button-outline bg-danger text-white border-danger text-uppercase fw-bold w-100 py-3 small text-center text-decoration-none border-0">
                            Bevestig & Verwijder Boeking #@Model.Id
                        </button>

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="custom-button-outline text-uppercase fw-bold w-100 py-3 small text-center text-decoration-none text-dark">
                            Annuleren
                        </a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>