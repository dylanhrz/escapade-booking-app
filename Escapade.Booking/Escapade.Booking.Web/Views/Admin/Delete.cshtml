@model AdminDeleteBookingViewModel

@{
    ViewData["Title"] = "Boeking Verwijderen";
}

<section class="section-header full-bleed text-center">
    <div>
        <p class="text-uppercase text-danger">Beheerdersactie / Onomkeerbaar</p>
        <h2>Boeking Verwijderen</h2>
    </div>
</section>

<section class="border-end-1 border-start-1 my-5">
    <div class="container-fluid p-0">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-7 border-end-1 p-4 p-lg-5 d-flex flex-column justify-content-between">
                <div>
                    
                    <p class="info-label mb-4">
                        Weet u zeker dat u deze boeking wilt verwijderen? Deze actie verwijdert de boeking definitief uit het systeem en kan niet ongedaan worden gemaakt.
                    </p>
                    
                    <h2 class="display-6 font-non-serif text-uppercase fw-bold mb-4">
                       
                    </h2>
                    
                    <span class="info-label text-uppercase">Naam</span>
                    <h3 class="info-head text-uppercase mt-2">
                        @Model.Name
                    </h3>

                    <div class="my-4">
                        <p class="text-uppercase info-label mb-1">Gereserveerde Periode</p>
                        <p class="h4 font-monospace m-0">
                            @Model.StartDate?.ToString("dd/MM/yyyy") — @Model.EndDate?.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 p-4 p-lg-5 d-flex flex-column justify-content-center">
                <form asp-controller="Admin" asp-action="Delete" method="post" class="w-100">
                    <input type="hidden" asp-for="Id"/>

                    <div class="d-flex flex-column gap-3">
                        
                        <h3 class="contact-heading mt-2">
                            <button type="submit" 
                                    class="contact-link border-0 bg-transparent p-0 text-start fw-bolder text-uppercase text-decoration-underline" 
                                    data-text="Bevestig & Verwijder Boeking #@Model.Id">
                                <span>Bevestig & Verwijder Boeking #@Model.Id</span>
                            </button>
                        </h3>
                        
                        <h3 class="contact-heading mt-2">
                            <a asp-controller="Admin"
                               asp-action="Index"
                               class="contact-link text-decoration-underline my-2" 
                               data-text="Annuleren">
                                <span>Annuleren</span>
                            </a>
                        </h3>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>