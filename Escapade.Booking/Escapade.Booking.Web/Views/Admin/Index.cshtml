@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4 mt-4">
    <a asp-action="Logout" class="btn btn-outline-dark btn-sm rounded-0 text-uppercase">Uitloggen</a>
</div>

<div class="mb-5">
    <div class="mb-4">
        <h2 class="h3 fw-bold text-uppercase mb-0">Aankomende Boekingen</h2>
    </div>

    @if (!Model.UpcomingBookings.Any())
    {
        <p class="text-muted">Er zijn momenteel geen aankomende boekingen.</p>
    }
    else
    {
        @foreach (var booking in Model.UpcomingBookings)
        {
            <div class="pb-3 mb-4">
                
                <div class="d-flex justify-content-between align-items-baseline">
                    <h3 class="h4 fw-bold text-uppercase mb-1">@booking.Name</h3>
                    <span class="fw-bold fs-5">
                        @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>

                <p class="mb-1"><strong>Contact:</strong> @booking.Email | @booking.PhoneNumber (@booking.NumberOfGuests gasten)</p>

                @if (!string.IsNullOrEmpty(booking.Comment))
                {
                    <p class="small text-muted mb-0"><em>"@booking.Comment"</em></p>
                }

                <div class="mt-2">
                    <a asp-controller="Booking"
                       asp-action="TrackBooking"
                       asp-route-token="@booking.AccessToken"
                       target="_blank"
                       class="btn btn-sm btn-outline-dark rounded-0 text-uppercase">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Bekijk Klantpagina
                    </a>
                </div>
                
            </div>
        }
    }
</div>

<div class="mb-5">
    <div class="mb-4">
        <h2 class="h3 fw-bold text-uppercase mb-0">Afgelopen Boekingen</h2>
    </div>

    @if (!Model.PastBookings.Any())
    {
        <p class="text-muted">Er zijn geen eerdere boekingen te vinden.</p>
    }
    else
    {
        @foreach (var booking in Model.PastBookings)
        {
            <div class="border-bottom pb-3 mb-3 text-secondary">
                <div class="d-flex justify-content-between align-items-baseline">
                    <h4 class="h5 fw-bold text-uppercase mb-1">@booking.Name</h4>
                    <span>
                        @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <p class="small mb-0">@booking.Email | @booking.PhoneNumber</p>
            </div>
        }
    }
</div>