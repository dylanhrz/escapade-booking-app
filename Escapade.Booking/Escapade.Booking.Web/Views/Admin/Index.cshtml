@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="full-bleed position-relative">
    <div class="container-fluid p-0">
        
        <div class="admin-cell col-12 p-4">
            <h2 class="text-uppercase font-non-serif m-0 fw-lighter">Aankomende boekingen</h2>
        </div>

        <div>
            @if (!Model.UpcomingBookings.Any())
            {
                <div class="p-5 border-bottom-2">
                    <p class="m-0 text-muted small text-uppercase fw-bold">Er zijn momenteel geen aankomende boekingen.</p>
                </div>
            }
            else
            {
                <div class="full-bleed">
                    @foreach (var booking in Model.UpcomingBookings)
                    {
                        <div class="border-bottom-2">
                            
                            <div class="row g-0">

                                <div class="col-6 p-5 border-end border-2 border-dark d-flex align-items-center">
                                    <span class="fw-bolder">
                                        @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                
                                <div class="col-6 p-5">
                                    <h3 class="text-uppercase fw-bold m-0 text-dark font-non-serif">@booking.Name</h3>
                                    <p class="m-0 mt-2">Email: <span class="fw-bolder">@booking.Email</span></p>
                                    <p class="m-0 mt-1">Telefoon: <span class="fw-bolder">@booking.PhoneNumber</span></p>
                                    
                                    @if (@booking.NumberOfGuests > 1)
                                    {
                                        <p class="m-0 mt-1">Aantal personen: <span class="fw-bolder">@booking.NumberOfGuests gasten</span></p>
                                    }
                                    else
                                    {
                                        <p class="m-0 mt-1">Aantal personen: <span class="fw-bolder">@booking.NumberOfGuests gast</span></p>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(booking.Comment))
                                    {
                                        <div class="mt-5">
                                            <p class="small m-0"><em>"@booking.Comment"</em></p>
                                        </div>
                                    }
                                    
                                </div>
                            </div>
                            
                            <div class="row g-0 border-top-2">
                                <div class="col-6 border-end-2">
                                    <a asp-controller="Booking"
                                       asp-action="TrackBooking"
                                       asp-route-token="@booking.AccessToken"
                                       target="_blank"
                                       class="admin-booking-btn">
                                        Bekijk Klantenpagina
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
        <div class="admin-cell col-12 p-4">
            <h2 class="text-uppercase font-non-serif m-0 fw-lighter">Afgelopen Boekingen</h2>
        </div>

        <div>

            @if (!Model.PastBookings.Any())
            {
                <div class="p-0">
                    <p class="m-0 text-muted small text-uppercase fw-bold">Er zijn geen eerdere boekingen te vinden.</p>
                </div>
            }
            else
            {
                <div class="full-bleed">
                    @foreach (var booking in Model.PastBookings)
                    {
                        <div class="text-secondary border-bottom-2">
                            
                            <div class="row g-0">

                                <div class="col-6 p-5 border-end border-2 border-dark d-flex align-items-center">
                                    <span class="fw-bolder">
                                        @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                
                                <div class="col-6 p-5">
                                    <h3 class="text-uppercase fw-bold m-0 text-dark font-non-serif">@booking.Name</h3>
                                    <p class="small mb-0 mt-2">Email: <span class="fw-bolder">@booking.Email</span></p>
                                    <p class="m-0 mt-1">Telefoon: <span class="fw-bolder">@booking.PhoneNumber</span></p>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
        <div class="col-12">
            <a asp-controller="Admin" asp-action="" class="admin-booking-btn">
                Alle afgelopen boekingen
            </a>
        </div>
        
    </div>
</section>