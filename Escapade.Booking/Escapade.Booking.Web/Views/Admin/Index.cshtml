@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var culture = new System.Globalization.CultureInfo("nl-BE");

    string StatusLabel(BaseViewModel booking) => booking.Status.ToString() switch
    {
        "Approved" => "Goedgekeurd",
        "DatesBlocked" => "Data vastgezet",
        _ => "Nieuwe aanvraag"
    };

    var newCount = Model.UpcomingBookings.Count(b => b.Status.ToString() == "Pending");
    var blockedCount = Model.UpcomingBookings.Count(b => b.Status.ToString() == "DatesBlocked");
    var approvedCount = Model.UpcomingBookings.Count(b => b.Status.ToString() == "Approved");
}

<section class="page-header container">
    <span class="contact-label mb-3">Beheer</span>
    <h1>Aanvragen</h1>
    <p>@newCount nieuw · @blockedCount vastgezet · @approvedCount goedgekeurd</p>
</section>

@if (TempData["Message"] != null)
{
    <div class="container">
        <div class="admin-message border-1 mb-4" role="status">@TempData["Message"]</div>
    </div>
}

<section class="full-bleed border-top-1 border-bottom-1">
    <div class="container">
        <div class="admin-list border-start-1 border-end-1">

            <h2 class="admin-list-head">Aankomend <span>(@Model.UpcomingBookings.Count)</span></h2>

            @if (!Model.UpcomingBookings.Any())
            {
                <p class="admin-list-empty">Er zijn momenteel geen aankomende aanvragen.</p>
            }

            @foreach (var booking in Model.UpcomingBookings)
            {
                var status = booking.Status.ToString();
                var nights = (booking.EndDate.Date - booking.StartDate.Date).Days;

                <article class="admin-booking @(status == "Pending" ? "is-new" : "")">
                    <div class="admin-booking-date">
                        <span class="admin-booking-day">@booking.StartDate.ToString("dd")</span>
                        <span class="contact-label">@booking.StartDate.ToString("MMM yyyy", culture)</span>
                        <span class="admin-booking-meta">t/m @booking.EndDate.ToString("dd MMM", culture) · @nights @(nights == 1 ? "nacht" : "nachten")</span>
                    </div>

                    <div class="admin-booking-info">
                        <span class="admin-status admin-status-@status.ToLower()">@StatusLabel(booking)</span>
                        <h3>@booking.Name</h3>
                        <p class="admin-booking-meta">
                            @booking.NumberOfGuests @(booking.NumberOfGuests == 1 ? "gast" : "gasten")
                            · @booking.Email
                            · @booking.PhoneNumber
                        </p>
                        @if (!string.IsNullOrWhiteSpace(booking.Comment))
                        {
                            <p class="admin-booking-comment">@booking.Comment</p>
                        }
                    </div>

                    <div class="admin-booking-actions">
                        <a asp-controller="Admin" asp-action="Details" asp-route-id="@booking.Id" class="btn-grid">Open aanvraag</a>

                        <div class="admin-links">
                            <a href="mailto:@booking.Email">Mail klant</a>
                            <a href="tel:@booking.PhoneNumber">Bel klant</a>

                            @if (status == "Pending")
                            {
                                <form asp-controller="Admin" asp-action="SetDatesBlocked" asp-route-id="@booking.Id" method="post">
                                    <input type="hidden" name="blocked" value="true" />
                                    <button type="submit">Data vastzetten</button>
                                </form>
                            }
                            else if (status == "DatesBlocked")
                            {
                                <form asp-controller="Admin" asp-action="SetDatesBlocked" asp-route-id="@booking.Id" method="post">
                                    <input type="hidden" name="blocked" value="false" />
                                    <button type="submit">Data vrijgeven</button>
                                </form>
                            }

                            @if (status != "Approved")
                            {
                                <form asp-controller="Admin" asp-action="ApproveBooking" asp-route-id="@booking.Id" method="post">
                                    <button type="submit">Goedkeuren</button>
                                </form>
                            }

                            <a asp-controller="Booking" asp-action="TrackBooking" asp-route-token="@booking.AccessToken" target="_blank">Klantpagina</a>
                            <a asp-controller="Admin" asp-action="Delete" asp-route-id="@booking.Id" class="admin-link-danger">Verwijderen</a>
                        </div>
                    </div>
                </article>
            }

            <h2 class="admin-list-head">Afgelopen <span>(@Model.PastBookings.Count)</span></h2>

            @if (!Model.PastBookings.Any())
            {
                <p class="admin-list-empty">Er zijn geen eerdere aanvragen.</p>
            }

            @foreach (var booking in Model.PastBookings)
            {
                <article class="admin-booking is-past">
                    <div class="admin-booking-date">
                        <span class="admin-booking-day">@booking.StartDate.ToString("dd")</span>
                        <span class="contact-label">@booking.StartDate.ToString("MMM yyyy", culture)</span>
                        <span class="admin-booking-meta">t/m @booking.EndDate.ToString("dd MMM", culture)</span>
                    </div>

                    <div class="admin-booking-info">
                        <span class="admin-status">@StatusLabel(booking)</span>
                        <h3>@booking.Name</h3>
                        <p class="admin-booking-meta">@booking.Email · @booking.PhoneNumber</p>
                    </div>

                    <div class="admin-booking-actions">
                        <div class="admin-links">
                            <a asp-controller="Admin" asp-action="Details" asp-route-id="@booking.Id">Open aanvraag</a>
                            <a asp-controller="Booking" asp-action="TrackBooking" asp-route-token="@booking.AccessToken" target="_blank">Klantpagina</a>
                            <a asp-controller="Admin" asp-action="Delete" asp-route-id="@booking.Id" class="admin-link-danger">Verwijderen</a>
                        </div>
                    </div>
                </article>
            }

        </div>
    </div>
</section>
