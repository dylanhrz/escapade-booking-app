@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h1 class="h3 font-weight-bold text-uppercase">Overzicht</h1>
    <a asp-action="Logout" class="btn btn-outline-dark btn-sm rounded-0 text-uppercase">Uitloggen</a>
</div>

@if (!Model.Bookings.Any())
{
    <p>Er zijn momenteel geen boekingen gevonden.</p>
}
else
{
    @foreach (var booking in Model.Bookings)
    {
        <div>
            <h2>(@booking.StartDate.ToString("dd/MM/yyyy") - @booking.EndDate.ToString("dd/MM/yyyy")) @booking.Name</h2>
            <p>@booking.Comment</p>
        </div>
    }         
};