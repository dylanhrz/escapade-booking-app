@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="full-bleed position-relative">
    <div class="container-fluid p-0">
        
        <div class="p-5 border-bottom border-dark">
            <h1 class="display-6 text-uppercase m-0 font-non-serif">Aankomende boekingen</h1>
        </div>

        <div class="p-5 border-bottom border-dark">
            @if (!Model.UpcomingBookings.Any())
            {
                <div class="p-4 border border-dark">
                    <p class="m-0 text-muted small text-uppercase fw-bold">Er zijn momenteel geen aankomende boekingen.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var booking in Model.UpcomingBookings)
                    {
                        <div class="p-5 border border-dark bg-white">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
                                <h3 class="text-uppercase m-0 font-non-serif">
                                    @booking.Name
                                </h3>
                                <span class="badge bg-dark text-white rounded-0 px-3 py-2 text-uppercase fs-6">
                                    @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                                </span>
                            </div>

                            <p class="fw-bolder text-uppercase small mb-2">
                                <span class="custom-blue">@booking.NumberOfGuests gast(en)</span> <br/>
                                email: @booking.Email <br/>
                                telefoonnummer: @booking.PhoneNumber 
                            </p>

                            @if (!string.IsNullOrEmpty(booking.Comment))
                            {
                                <div class="p-3 bg-light border border-dark mb-4">
                                    <p class="small m-0 text-muted"><em>"@booking.Comment"</em></p>
                                </div>
                            }

                            <div class="pt-2">
                                <a asp-controller="Booking"
                                   asp-action="TrackBooking"
                                   asp-route-token="@booking.AccessToken"
                                   target="_blank"
                                   class="btn btn-outline-dark rounded-0 text-uppercase fw-bold px-4 py-2 small">
                                    <i class="bi bi-box-arrow-up-right me-2"></i> Bekijk Klantpagina
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
        <div class="p-5 border-bottom border-dark">
            <h2 class="display-6 text-uppercase m-0 font-non-serif">Afgelopen Boekingen</h2>
        </div>

        <div class="p-5 border-bottom border-dark">

            @if (!Model.PastBookings.Any())
            {
                <div class="p-4 border border-dark bg-white">
                    <p class="m-0 text-muted small text-uppercase fw-bold">Er zijn geen eerdere boekingen te vinden.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var booking in Model.PastBookings)
                    {
                        <div class="p-4 border border-dark bg-white text-secondary opacity-75">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                                <div>
                                    <h4 class="h5 text-uppercase fw-bold m-0 text-dark">@booking.Name</h4>
                                    <p class="small text-uppercase fw-bolder mb-0 mt-1">@booking.Email &bull; @booking.PhoneNumber</p>
                                </div>
                                <span class="fw-bold small text-dark">
                                    @booking.StartDate.ToString("dd/MM/yyyy") — @booking.EndDate.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>