@model AdminLoginViewModel

@{
    ViewData["Title"] = "Log in";
    
    var modelOnlyErrors = ViewData.ModelState[string.Empty]?.Errors.Count > 0;
}

<section class="position-relative">
    <div class="container-fluid p-0">
        
        <form asp-controller="Admin" asp-action="Login" method="post" class="d-flex flex-column">
            
            @if (modelOnlyErrors)
            {
                <div class="form-cell col-12 p-5 border-bottom-1 border-start-1 border-end-1">
                    <div asp-validation-summary="ModelOnly" class="custom-validation-summary"></div>
                </div>
            }
            
            <div class="row g-0">
                <div class="form-cell col-12 col-md-6 p-5 border-start-1 border-end-1">
                    
                    <label asp-for="Email" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Email" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Email</span>
                        }
                    </label>

                    <input asp-for="Email" class="form-input"/>
                    
                </div>
                
                <div class="form-cell col-12 col-md-6 p-5 border-end-1">
                    
                    <label asp-for="Password" class="fw-bolder text-uppercase small">
                        @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                        {
                            <span asp-validation-for="Password" class="text-danger"></span>
                        }
                        else
                        {
                            <span class="form-label">Wachtwoord</span>
                        }
                    </label>

                    <input asp-for="Password" type="password" class="form-input"/>
                    
                </div>
            </div>
            
            <div class="row g-0">
                <div class="col-12">
                    <button type="submit" class="form-btn py-4 fs-5 d-flex align-items-center justify-content-center gap-3 border-top-0">
                        <span>Aanmelden</span>
                    </button>
                </div>
            </div>

        </form>
    </div>
</section>