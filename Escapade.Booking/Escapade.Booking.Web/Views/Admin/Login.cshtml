@model AdminLoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5 mt-5">
    <div class="w-100 mt-5" style="max-width: 400px;">
        
        <h1 class="font-serif text-center mb-5 display-5 mt-5">
            @ViewData["Title"]
        </h1>
        
        <form asp-controller="Admin" asp-action="Login" method="post" class="d-flex flex-column gap-3">
            
            <div asp-validation-summary="ModelOnly" class="text-danger small text-center fw-bold"></div>
            
            <div class="d-flex flex-column gap-1">
                
                <label asp-for="Email" class="fw-bolder text-uppercase small">
                    @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                    {
                        <span asp-validation-for="Email" class="text-danger"></span>
                    }
                    else
                    {
                        <span>Email</span>
                    }
                </label>

                <input asp-for="Email"
                       class="form-control px-3 py-2 bg-white border rounded-0 border-secondary-subtle"/>
            </div>
            
            <div class="d-flex flex-column gap-1">
                
                <label asp-for="Password" class="fw-bolder text-uppercase small">
                    @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                    {
                        <span asp-validation-for="Password" class="text-danger"></span>
                    }
                    else
                    {
                        <span>Wachtwoord</span>
                    }
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control px-3 py-2 bg-white border rounded-0 border-secondary-subtle"/>
            </div>

            <button type="submit" 
                    class="btn btn-dark w-100 py-3 mt-3 fw-medium border-0 rounded-0">
                Inloggen
            </button>
        </form>

    </div>
</div>