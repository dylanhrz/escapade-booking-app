@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - L'Escapade Ardennaise</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>

<body class="min-vh-100 d-flex flex-column overflow-x-hidden">
<header>
    <nav class="navbar navbar-expand-sm py-0 my-0 align-items-center" style="min-height: 70px;">
        <div class="container-fluid px-4 px-md-5 align-items-center">

            <a class="navbar-brand text-dark fw-bolder text-uppercase brand-logo m-0" asp-controller="Home" asp-action="Index">
                L'ESCAPADE ARDENNAISE
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav gap-3 gap-sm-4 ms-auto my-3 my-sm-0 text-center align-items-center">
                    <li class="nav-item">
                        <a class="nav-link text-dark text-uppercase nav-item-link px-2 @(current == "Location" ? "active-link" : "")" asp-controller="Location" asp-action="Index">LOCATION</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark text-uppercase nav-item-link px-2 @(current == "Contact" ? "active-link" : "")" asp-controller="Contact" asp-action="Index">CONTACT</a>
                    </li>
                    <li id="nav-booking">
                        <a class="nav-link text-light text-uppercase nav-item-link px-2 @(current == "Booking" ? "active-link" : "")" asp-controller="Booking" asp-action="NewBooking">BOEK NU</a>
                    </li>
                </ul>
            </div>

        </div>
    </nav>
</header>

<div class="container-fluid px-4 px-md-5 flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="border-top border-dark footer text-muted mt-auto pb-5">
    <div class="container-fluid px-4 px-md-5 mt-5">
        L'Escapade Ardennaise
        - <a asp-controller="Contact" asp-action="Index" class="text-dark fw-bold">Contact</a>
        - <a asp-controller="Admin" asp-action="Login" class="text-dark fw-bold">Login</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>