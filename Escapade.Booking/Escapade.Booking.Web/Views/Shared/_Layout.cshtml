@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - L'Escapade Ardennaise</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>

<body class="min-vh-100 d-flex flex-column overflow-x-hidden">
<header>
    <nav class="navbar navbar-expand-lg py-0 my-0 align-items-center position-relative" style="min-height: 70px;">
        <div class="container-fluid px-4 px-md-5 d-flex align-items-center justify-content-between flex-wrap nav-padding">

            <a class="navbar-brand text-dark fw-bolder text-uppercase brand-logo nav-centered-logo m-0 d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">
                L'ESCAPADE ARDENNAISE
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse w-100" id="mainNavbar">
                <ul class="navbar-nav gap-3 gap-sm-4 me-auto text-center align-items-center my-3 my-lg-0">
                    <li class="nav-item d-flex align-items-center">
                        <a class="nav-link text-dark text-uppercase nav-item-link p-0 @(current == "Location" ? "active-link" : "")" asp-controller="Location" asp-action="Index">Locatie</a>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <a class="nav-link text-dark text-uppercase nav-item-link p-0 @(current == "Contact" ? "active-link" : "")" asp-controller="Contact" asp-action="Index">Contact</a>
                    </li>
                </ul>

                <ul class="navbar-nav gap-3 gap-sm-4 ms-auto text-center align-items-center mb-3 mb-lg-0">
                    <li id="nav-booking" class="nav-item d-flex align-items-center">
                        <a class="nav-link text-light text-uppercase nav-item-link @(current == "Booking" ? "active-link" : "")" asp-controller="Booking" asp-action="NewBooking">Boek nu</a>
                    </li>
                    <li class="nav-item dropdown d-flex align-items-center">
                        <a class="nav-link dropdown-toggle text-dark text-uppercase fw-bold p-0" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            NL
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end text-center shadow-sm" aria-labelledby="languageDropdown">
                            <li><a class="dropdown-item" href="?culture=nl">NL</a></li>
                            <li><a class="dropdown-item" href="?culture=fr">FR</a></li>
                            <li><a class="dropdown-item" href="?culture=en">EN</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

        </div>
    </nav>
</header>

<div class="container-fluid px-4 px-md-5 flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="border-top border-dark footer text-muted mt-auto pb-5">
    <div class="container-fluid px-4 px-md-5 mt-5">
        <p class="text-uppercase fw-bold text-dark">L'Escapade Ardennaise</p>
        <a asp-controller="Location" asp-action="Index" class="text-dark custom-hover text-decoration-none">Locatie</a> <br />
        <a asp-controller="Booking" asp-action="NewBooking" class="text-dark custom-hover text-decoration-none">Verblijf aanvragen</a> <br />
        <a asp-controller="Contact" asp-action="Index" class="text-dark custom-hover text-decoration-none">Contact</a> <br />
        <a asp-controller="Admin" asp-action="Login" class="text-dark custom-hover text-decoration-none">Admin</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>