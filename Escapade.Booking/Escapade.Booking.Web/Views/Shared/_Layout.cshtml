@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToUpper();
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] • L'Escapade Ardennaise</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>

<body class="min-vh-100 d-flex flex-column overflow-x-hidden">
<header>
    <div class="container-fluid p-0">
        <nav class="navbar navbar-expand-lg p-0 m-0 align-items-stretch">
            <div class="container-fluid p-0 d-flex flex-wrap align-items-stretch justify-content-between">

                <div class="d-none d-lg-flex align-items-stretch justify-content-end nav-side">
                    <a class="nav-block-btn border-start-1 border-end-1 @(currentController == "About" && currentAction == "Index" ? "active" : "")"
                       asp-controller="About"
                       asp-action="Index">
                        @Localizer["About"]
                    </a>

                    <a class="nav-block-btn border-end-1 @(currentController == "About" && currentAction == "Rooms" ? "active" : "")"
                       asp-controller="About"
                       asp-action="Rooms">
                        Slaapkamers
                    </a>

                    <a class="nav-block-btn border-end-1 @(currentController == "About" && currentAction == "Rocquingy" ? "active" : "")"
                       asp-controller="About"
                       asp-action="Rocquingy">
                        Rocquigny
                    </a>
                </div>

                <a class="navbar-brand text-uppercase fw-bolder d-flex align-items-center justify-content-center m-0 py-2"
                   asp-controller="Home"
                   asp-action="Index">
                    L'ESCAPADE ARDENNAISE
                </a>

                <button class="navbar-toggler border-0 shadow-none me-3" 
                        type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target="#mainNavbar" 
                        aria-controls="mainNavbar" 
                        aria-expanded="false" 
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse align-items-stretch nav-side" id="mainNavbar">
                    
                    <div class="d-flex d-lg-none flex-column w-100">
                        <a class="nav-block-btn w-100 @(currentController == "About" && currentAction == "Index" ? "active" : "")"
                           asp-controller="About"
                           asp-action="Index">
                            @Localizer["About"]
                        </a>
                        <a class="nav-block-btn w-100 border-top-1 border-bottom-1 @(currentController == "About" && currentAction == "Rooms" ? "active" : "")"
                           asp-controller="About"
                           asp-action="Rooms">
                            Slaapkamers
                        </a>
                        <a class="nav-block-btn w-100 @(currentController == "About" && currentAction == "Rocquingy" ? "active" : "")"
                           asp-controller="About"
                           asp-action="Rocquingy">
                            Rocquigny
                        </a>
                    </div>

                    <ul class="navbar-nav w-100 d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center my-0">
                        
                        <!--
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-block-btn w-100"
                               asp-controller=""
                               asp-action="">
                                Accommodatie
                            </a>
                        </li>
                        -->
                        
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-block-btn w-100 @(currentController == "Contact" ? "active" : "")"
                               asp-controller="Contact"
                               asp-action="Index">
                                @Localizer["Contact"]
                            </a>
                        </li>

                        <li class="nav-item d-flex align-items-center">
                            @if (Context.Session.GetString("AdminId") != null)
                            {
                                <a class="nav-block-btn @(currentController == "Admin" ? "active-admin" : "")"
                                   asp-controller="Admin"
                                   asp-action="Logout">
                                    @Localizer["SignOut"]
                                </a>
                            }
                            else
                            {
                                <a class="nav-block-btn @(currentController == "Booking" ? "active" : "")"
                                   asp-controller="Booking"
                                   asp-action="CreateBooking">
                                    @Localizer["Book"]
                                </a>
                            }
                        </li>

                        <!--
                        <li class="nav-item dropdown d-flex align-items-center">
                            <a class="nav-link dropdown-toggle text-dark text-uppercase p-0 w-100 h-100 d-flex align-items-center justify-content-center" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @currentCulture
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end text-center" aria-labelledby="languageDropdown">
                                <li>
                                    <form asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" asp-route-culture="nl" method="post">
                                        <button type="submit" class="dropdown-item @(currentCulture == "NL" ? "fw-bold" : "")">NL</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" asp-route-culture="fr" method="post">
                                        <button type="submit" class="dropdown-item @(currentCulture == "FR" ? "fw-bold" : "")">FR</button>
                                    </form>
                                </li>
                                <li>
                                    <form asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" asp-route-culture="en" method="post">
                                        <button type="submit" class="dropdown-item @(currentCulture == "EN" ? "fw-bold" : "")">EN</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        -->


                    </ul>
                </div>
            </div>
        </nav>
    </div>
</header>

<div class="container p-0 flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="footer-grid mt-auto">
    <div class="container">
        <div class="row g-0">
            <div class="col-lg-8 footer-cell footer-brand-col">
                <h2>L'ESCAPADE ARDENNAISE</h2>
            </div>
            <div class="col-lg-4 footer-cell footer-links-col">
                <ul>
                    <li>
                        <a asp-controller="About" asp-action="Index">
                            @Localizer["About"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="About" asp-action="Rooms">
                            Kamers
                        </a>
                    </li>
                    <li>
                        <a asp-controller="About" asp-action="Rocquingy">
                            Rocquigny
                        </a>
                    </li>
                    
                    <!--
                    <li>
                        <a asp-controller="" asp-action="">
                            Accommodatie
                        </a>
                    </li>
                    -->
                    
                    <li>
                        <a asp-controller="Booking" asp-action="CreateBooking">
                            @Localizer["Book"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Contact" asp-action="Index">
                            @Localizer["Contact"]
                        </a>
                    </li>
                    <!--
                    <li>
                        <a asp-controller="Admin" asp-action="Login">
                            Admin
                        </a>
                    </li>
                    -->
                </ul>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>