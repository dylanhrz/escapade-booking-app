@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] • L'Escapade Ardennaise</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>

<body class="min-vh-100 d-flex flex-column overflow-x-hidden">
<header>
    <div class="container-fluid p-0">
        <nav class="navbar navbar-expand-lg p-0 m-0 align-items-stretch">
            <div class="container-fluid p-0 d-flex align-items-stretch justify-content-between">

                <div class="d-none d-lg-flex align-items-stretch justify-content-end nav-side">
                    <a class="nav-block-btn @(current == "About" ? "active" : "")"
                       asp-controller=""
                       asp-action="">
                        Het verblijf
                    </a>
                </div>

                <a class="navbar-brand fw-bolder text-uppercase d-flex align-items-center justify-content-center py-3 m-0 px-4 border-start-1"
                   asp-controller="Home"
                   asp-action="Index">
                    L'ESCAPADE ARDENNAISE
                </a>

                <button class="navbar-toggler border-0 shadow-none me-3" 
                        type="button" 
                        data-bs-toggle="collapse" 
                        data-bs-target="#mainNavbar" 
                        aria-controls="mainNavbar" 
                        aria-expanded="false" 
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse align-items-stretch nav-side" id="mainNavbar">

                    <div class="d-flex d-lg-none align-items-stretch">
                        <a class="nav-block-btn @(current == "About" ? "active" : "")"
                           asp-controller=""
                           asp-action="">
                            Het verblijf
                        </a>
                    </div>

                    <ul class="navbar-nav align-items-center my-0 w-100">

                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-block-btn @(current == "Contact" ? "active" : "")"
                               asp-controller="Contact"
                               asp-action="Index">
                                Contact
                            </a>
                        </li>

                        <li class="nav-item d-flex align-items-center">
                            @if (Context.Session.GetString("AdminId") != null)
                            {
                                <a class="nav-block-btn @(current == "Admin" ? "active-admin" : "")"
                                   asp-controller="Admin"
                                   asp-action="Logout">
                                    Uitloggen
                                </a>
                            }
                            else
                            {
                                <a class="nav-block-btn @(current == "Booking" ? "active" : "")"
                                   asp-controller="Booking"
                                   asp-action="CreateBooking">
                                    Boek nu
                                </a>
                            }
                        </li>

                        <li class="nav-item dropdown d-flex align-items-center">
                            <a class="nav-link dropdown-toggle text-dark text-uppercase p-0 w-100 h-100 d-flex align-items-center justify-content-center" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                NL
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end text-center" aria-labelledby="languageDropdown">
                                <li><a class="dropdown-item" href="?culture=nl">NL</a></li>
                                <li><a class="dropdown-item" href="?culture=fr">FR</a></li>
                                <li><a class="dropdown-item" href="?culture=en">EN</a></li>
                            </ul>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </div>
</header>

<div class="container p-0 flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="footer-grid mt-auto">
    <div class="footer-cell footer-brand-col">
        <h2 class="footer-title">L'ESCAPADE ARDENNAISE</h2>
    </div>
    <div class="footer-cell footer-links-col">
        <ul class="footer-links">
            <li>
                <a asp-controller="Home" asp-action="Index" class="footer-link">Het verblijf</a>
            </li>
            <li>
                <a asp-controller="Booking" asp-action="CreateBooking" class="footer-link">Verblijf aanvragen</a>
            </li>
            <li>
                <a asp-controller="Contact" asp-action="Index" class="footer-link">Contact</a>
            </li>
            <li>
                <a asp-controller="Admin" asp-action="Login" class="footer-link">Admin</a>
            </li>
        </ul>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
